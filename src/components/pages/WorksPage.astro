---
/*
  作品頁 —— 星表：作品在前（各一則完整條目），服務另立一節在後。
  服務不是產品：不給星表編號、以環標記號呈現，但同樣有完整條目。
  結構：記號＋編號／籤＋明體名／類型／狀態 → 摘要 → 重點（髮絲清單）→ 入口。
  錨點 = 條目 id。
*/
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import { useTranslations, type Locale } from "@/i18n/utils";
import { chapterMark } from "@/lib/chapters";
import { WORKS, SERVICES, type CatalogEntry } from "@/lib/catalog";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/** 兩節共用的條目版式（作品＝星芒＋編號；服務＝環標＋「服務」籤）。 */
const sections: { entries: CatalogEntry[]; head: null | { eyebrow: string; title: string; lead: string } }[] = [
  { entries: WORKS, head: null },
  {
    entries: SERVICES,
    head: {
      eyebrow: t("home.services.eyebrow"),
      title: t("home.services.title"),
      lead: t("home.services.lead"),
    },
  },
];
---

<Layout locale={locale} title={t("nav.works")} description={t("works.lead")}>
  <main id="main">
    <PageHero
      mark={chapterMark("works")}
      eyebrow={t("works.eyebrow")}
      title={t("works.title")}
      lead={t("works.lead")}
    />

    <div class="hv-container">
      {
        sections.map(({ entries, head }) => (
          <>
            {head && (
              <div class="hv-work-sep">
                <div class="hv-section-head">
                  <p class="hv-eyebrow" data-reveal>
                    <span class="hv-eyebrow__ring" aria-hidden="true" />
                    {head.eyebrow}
                  </p>
                  <h2 data-reveal>{head.title}</h2>
                  <p class="hv-lead" data-reveal>{head.lead}</p>
                </div>
              </div>
            )}
            {entries.map((p) => (
          <section
            id={p.id}
            class="hv-work"
            style={`--work-accent: var(${p.accentVar})`}
            aria-labelledby={`${p.id}-title`}
          >
            <div class="hv-work__head" data-reveal>
              <span class="hv-work__mark" aria-hidden="true">
                {p.kind === "work" ? (
                  <svg class="hv-work__star" viewBox="0 0 24 24">
                    <path d="M12 1 Q13 11 23 12 Q13 13 12 23 Q11 13 1 12 Q11 11 12 1 Z" />
                  </svg>
                ) : (
                  <svg class="hv-work__star is-ring" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="8.5" fill="none" stroke-width="2" />
                    <circle cx="12" cy="12" r="2.6" stroke="none" />
                  </svg>
                )}
                <span class="hv-catalog">
                  {p.kind === "work" ? p.catalog : t("label.service")}
                </span>
              </span>
              <div>
                <h2 id={`${p.id}-title`} class="hv-work__name hv-display">
                  {t(p.nameKey)}{" "}
                  {t(p.latinKey).toLowerCase() !== t(p.nameKey).toLowerCase() && (
                    <span class="hv-work__latin">{t(p.latinKey)}</span>
                  )}
                </h2>
                <p class="hv-work__kind">{t(p.kindKey)}</p>
              </div>
              <span class="hv-badge hv-work__status" class:list={{ "hv-badge--live": p.live }}>
                {t(p.statusKey)}
              </span>
            </div>

            <p class="hv-work__desc" data-reveal>
              {t(p.descKey)}
            </p>

            <ul class="hv-work__features">
              {p.featureKeys.map((f) => (
                <li class="hv-work__feature" data-reveal>
                  <span class:list={["hv-work__feature-mark", { "is-service": p.kind === "service" }]} aria-hidden="true">
                    {p.kind === "work" ? (
                      <svg viewBox="0 0 24 24">
                        <path d="M12 3 Q13 11 21 12 Q13 13 12 21 Q11 13 3 12 Q11 11 12 3 Z" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="7.5" fill="none" stroke-width="2" />
                        <circle cx="12" cy="12" r="2.2" stroke="none" />
                      </svg>
                    )}
                  </span>
                  {t(f)}
                </li>
              ))}
            </ul>

            {p.url ? (
              <div class="hv-work__foot" data-reveal>
                <a
                  class="hv-btn hv-btn--primary"
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                >
                  {t(p.kind === "work" ? "cta.visitWork" : "cta.visitService")}
                  <span aria-hidden="true">↗</span>
                  <span class="hv-visually-hidden">{t("a11y.external")}</span>
                </a>
              </div>
            ) : null}
          </section>
            ))}
          </>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .hv-work {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    /* sticky header 下的錨點落點 */
    scroll-margin-top: 90px;
  }
  .hv-work + .hv-work {
    border-top: 1px solid var(--hv-line);
  }

  .hv-work__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--hv-space-6);
  }
  /* 名稱區塊可伸縮；空間不足時狀態徽章自然換行 */
  .hv-work__head > div {
    flex: 1 1 260px;
  }
  .hv-work__mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }
  .hv-work__star {
    width: 20px;
    height: 20px;
    fill: var(--work-accent);
    filter: drop-shadow(0 0 8px var(--work-accent));
  }
  .hv-work__star.is-ring {
    stroke: var(--work-accent);
    filter: none;
  }

  /* 服務節的標題組：與上一節之間拉開一條星圖線 */
  .hv-work-sep {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--hv-line);
  }
  .hv-work__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7rem;
    font-size: var(--hv-text-2xl);
  }
  .hv-work__latin {
    /* 字典裡存的是真正的名字（`Shattered Realms`），不是全大寫的字面值——
       搜尋引擎讀的是文字本身。外觀的全大寫在這一行。 */
    text-transform: uppercase;
    font-family: var(--hv-font-mono);
    font-size: var(--hv-text-xs);
    letter-spacing: var(--hv-tracking-wide);
    color: var(--hv-text-faint);
  }
  .hv-work__kind {
    margin-top: var(--hv-space-2);
    color: var(--work-accent);
    font-weight: 600;
    font-size: var(--hv-text-sm);
  }
  .hv-work__status {
    margin-left: auto;
    flex-shrink: 0;
  }

  .hv-work__desc {
    margin-top: var(--hv-space-6);
    max-width: 62ch;
    color: var(--hv-text-soft);
    font-size: var(--hv-text-base);
  }

  /* 特點：沿用作品星／服務環標作為視覺記號，不再用序號重述順序 */
  .hv-work__features {
    list-style: none;
    padding: 0;
    margin-top: var(--hv-space-8);
    max-width: 720px;
  }
  .hv-work__feature {
    display: flex;
    gap: var(--hv-space-6);
    align-items: baseline;
    padding-block: var(--hv-space-4);
    border-top: 1px solid var(--hv-line);
    color: var(--hv-text);
    font-size: var(--hv-text-sm);
    line-height: 1.75;
  }
  .hv-work__feature:last-child {
    border-bottom: 1px solid var(--hv-line);
  }
  .hv-work__feature-mark {
    display: inline-grid;
    place-items: center;
    color: var(--work-accent);
    flex-shrink: 0;
  }
  .hv-work__feature-mark svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
  }
  .hv-work__feature-mark.is-service svg {
    stroke: currentColor;
  }

  .hv-work__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-8);
  }

  @media (max-width: 860px) {
    .hv-work__mark {
      flex-direction: row;
      gap: 0.6rem;
      margin-top: 0;
    }
    .hv-work__status {
      margin-left: 0;
    }
  }
</style>
