---
/*
  作品頁 —— 星表：每件作品一則完整條目（錨點 = 作品 id）。
  結構：星表編號＋識別色星記＋明體名／類型／狀態 → 摘要 → 三項特點（髮絲清單）→ 入口。
*/
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import { useTranslations, bayer, type Locale } from "@/i18n/utils";
import { PRODUCTS } from "@/lib/products";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t("nav.works")} description={t("works.lead")}>
  <main id="main">
    <PageHero
      mark={bayer(1)}
      eyebrow={t("works.eyebrow")}
      title={t("works.title")}
      lead={t("works.lead")}
    />

    <div class="hv-container">
      {
        PRODUCTS.map((p) => (
          <section
            id={p.id}
            class="hv-work"
            style={`--work-accent: var(${p.accentVar})`}
            aria-labelledby={`${p.id}-title`}
          >
            <div class="hv-work__head" data-reveal>
              <span class="hv-work__mark" aria-hidden="true">
                <svg class="hv-work__star" viewBox="0 0 24 24">
                  <path d="M12 1 Q13 11 23 12 Q13 13 12 23 Q11 13 1 12 Q11 11 12 1 Z" />
                </svg>
                <span class="hv-catalog">{p.catalog}</span>
              </span>
              <div>
                <h2 id={`${p.id}-title`} class="hv-work__name hv-display">
                  {t(p.nameKey)}
                  {t(p.latinKey).toLowerCase() !== t(p.nameKey).toLowerCase() && (
                    <span class="hv-work__latin">{t(p.latinKey)}</span>
                  )}
                </h2>
                <p class="hv-work__kind">{t(p.kindKey)}</p>
              </div>
              <span class="hv-badge hv-work__status" class:list={{ "hv-badge--live": p.live }}>
                {t(p.statusKey)}
              </span>
            </div>

            <p class="hv-work__desc" data-reveal>
              {t(p.descKey)}
            </p>

            <ul class="hv-work__features">
              {p.featureKeys.map((f, i) => (
                <li class="hv-work__feature" data-reveal>
                  <span class="hv-work__feature-num" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  {t(f)}
                </li>
              ))}
            </ul>

            {p.url ? (
              <div class="hv-work__foot" data-reveal>
                <a
                  class="hv-btn hv-btn--primary"
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                >
                  {t("cta.visit")}
                  <span aria-hidden="true">↗</span>
                  <span class="hv-visually-hidden">{t("a11y.external")}</span>
                </a>
              </div>
            ) : null}
          </section>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .hv-work {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    /* sticky header 下的錨點落點 */
    scroll-margin-top: 90px;
  }
  .hv-work + .hv-work {
    border-top: 1px solid var(--hv-line);
  }

  .hv-work__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--hv-space-6);
  }
  /* 名稱區塊可伸縮；空間不足時狀態徽章自然換行 */
  .hv-work__head > div {
    flex: 1 1 260px;
  }
  .hv-work__mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }
  .hv-work__star {
    width: 20px;
    height: 20px;
    fill: var(--work-accent);
    filter: drop-shadow(0 0 8px var(--work-accent));
  }
  .hv-work__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7rem;
    font-size: var(--hv-text-2xl);
  }
  .hv-work__latin {
    font-family: var(--hv-font-mono);
    font-size: var(--hv-text-xs);
    letter-spacing: var(--hv-tracking-wide);
    color: var(--hv-text-faint);
  }
  .hv-work__kind {
    margin-top: var(--hv-space-2);
    color: var(--work-accent);
    font-weight: 600;
    font-size: var(--hv-text-sm);
  }
  .hv-work__status {
    margin-left: auto;
    flex-shrink: 0;
  }

  .hv-work__desc {
    margin-top: var(--hv-space-6);
    max-width: 62ch;
    color: var(--hv-text-soft);
    font-size: var(--hv-text-base);
  }

  /* 特點：編號髮絲清單（星表條目的細項，不做卡片） */
  .hv-work__features {
    list-style: none;
    padding: 0;
    margin-top: var(--hv-space-8);
    max-width: 720px;
  }
  .hv-work__feature {
    display: flex;
    gap: var(--hv-space-6);
    align-items: baseline;
    padding-block: var(--hv-space-4);
    border-top: 1px solid var(--hv-line);
    color: var(--hv-text);
    font-size: var(--hv-text-sm);
    line-height: 1.75;
  }
  .hv-work__feature:last-child {
    border-bottom: 1px solid var(--hv-line);
  }
  .hv-work__feature-num {
    font-family: var(--hv-font-mono);
    color: var(--work-accent);
    font-size: var(--hv-text-xs);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .hv-work__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-8);
  }

  @media (max-width: 860px) {
    .hv-work__mark {
      flex-direction: row;
      gap: 0.6rem;
      margin-top: 0;
    }
    .hv-work__status {
      margin-left: 0;
    }
  }
</style>
