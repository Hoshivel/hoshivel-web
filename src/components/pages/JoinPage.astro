---
/*
  Join -- what collaboration means here, the directions open right now (a row of
  plate cards), an open self-introduction, and how to get in touch.
  The default is **collaboration** (per-project, short-term, flexible part-time);
  an individual position can be marked `kind: "partner"` in roles.config.ts to
  become a long-term partnership, and the card's kind tag and call to action
  follow.
  Role card: serif title plus kind tag / scope / mode -> description -> the
  skills we hope for -> a mailto to start the conversation (the subject carries
  the title automatically, to lower the friction of writing in).
*/
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import { useTranslations, type Locale } from "@/i18n/utils";
import { chapterMark } from "@/lib/chapters";
import { getRoles, type RoleKind } from "@/lib/roles";
import { CAREERS_EMAIL, GITHUB_URL, PRESS_EMAIL } from "@/lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const roles = getRoles(locale);

/** The subject line is split by kind, so the recipient can tell a long-term partnership from ordinary collaboration at a glance. */
const applyHref = (kind: RoleKind, roleTitle: string) => {
  const prefix = kind === "partner" ? "Partner" : "Collab";
  return `mailto:${CAREERS_EMAIL}?subject=${encodeURIComponent(`[${prefix}] ${roleTitle}`)}`;
};

/*
  Business mail goes to its own mailbox, not just its own subject line: it comes
  from companies (publishing, platforms, press), and the person who answers it
  is not the one reading applications. `[Business]` stays so the subject still
  says what it is once the mail is out of its mailbox.
*/
const bizHref = `mailto:${PRESS_EMAIL}?subject=${encodeURIComponent(
  `[Business] ${t("join.biz.title")}`,
)}`;
---

<Layout locale={locale} title={t("nav.join")} description={t("join.lead")}>
  <main id="main">
    <PageHero
      mark={chapterMark("join")}
      eyebrow={t("join.eyebrow")}
      title={t("join.title")}
      lead={t("join.lead")}
    />

    <!-- What collaboration means: settle the relationship first, then talk about directions -->
    <section class="hv-collab" aria-labelledby="join-collab">
      <div class="hv-container">
        <div class="hv-plate hv-collab__card" data-reveal>
          <h2 id="join-collab" class="hv-join__h2 hv-display">
            {t("join.collab.title")}
          </h2>
          <p class="hv-collab__body">{t("join.collab.body")}</p>
        </div>
      </div>
    </section>

    <!-- Open positions -->
    <section class="hv-section" aria-labelledby="join-roles">
      <div class="hv-container">
        <h2 id="join-roles" class="hv-join__h2 hv-display" data-reveal>
          {t("join.roles.title")}
        </h2>
        <div class="hv-join-roles">
          {
            roles.map((role) => (
              <article class="hv-plate hv-join-role" id={role.id} data-reveal>
                <div class="hv-join-role__main">
                  <div class="hv-join-role__head">
                    <h3 class="hv-join-role__title hv-display">{role.title}</h3>
                    <span class="hv-badge hv-join-role__kind">
                      {t(`join.kind.${role.kind}`)}
                    </span>
                  </div>
                  <p class="hv-join-role__meta">
                    <span>{role.area}</span>
                    <span class="hv-join-role__dot" aria-hidden="true">
                      ·
                    </span>
                    <span>{t(`join.mode.${role.kind}`)}</span>
                  </p>
                  <p class="hv-join-role__desc">{role.desc}</p>
                  <p class="hv-join-role__skills">{role.skills}</p>
                </div>
                <a
                  class="hv-btn hv-btn--ghost hv-join-role__apply"
                  href={applyHref(role.kind, role.title)}
                >
                  {t(`join.apply.${role.kind}`)}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!--
      發行與商務合作 —— 對象是公司（發行、平臺、媒體），不是個人協作者。
      刻意獨立成一節、擺在協作方向之後：來的人目的不同，信箱主旨也不同
      （`[Business]`）。版式沿用首頁協作卡：文左、行動右、金色左欄。
    -->
    <section class="hv-section hv-join-biz" aria-labelledby="join-biz">
      <div class="hv-container">
        <div class="hv-plate hv-join-biz__card" data-reveal>
          <div>
            <h2 id="join-biz" class="hv-join__h2 hv-display">
              {t("join.biz.title")}
            </h2>
            <p class="hv-join-biz__body">{t("join.biz.body")}</p>
          </div>
          <a class="hv-btn hv-btn--primary hv-join-biz__cta" href={bizHref}>
            {t("join.biz.cta")}
          </a>
        </div>
      </div>
    </section>

    <!-- Open application plus contact details: warm paper band -->
    <section class="hv-section hv-join-open" aria-labelledby="join-open">
      <div class="hv-container hv-join-open__grid">
        <div data-reveal>
          <h2 id="join-open" class="hv-join__h2 hv-display">{t("join.open.title")}</h2>
          <p class="hv-join-open__body">{t("join.open.body")}</p>
        </div>
        <div data-reveal>
          <h2 class="hv-join__h2 hv-display">{t("join.how.title")}</h2>
          <p class="hv-join-open__body">{t("join.how.body")}</p>
          <div class="hv-join-open__cta">
            <a class="hv-btn hv-btn--primary" href={`mailto:${CAREERS_EMAIL}`}>
              {CAREERS_EMAIL}
            </a>
            <a class="hv-btn hv-btn--ghost" href={GITHUB_URL} target="_blank" rel="noopener">
              {t("footer.github")}
              <span aria-hidden="true">↗</span>
              <span class="hv-visually-hidden">{t("a11y.external")}</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hv-join__h2 {
    font-size: var(--hv-text-xl);
  }

  /* What collaboration means: a plate card with a gold rule on its left edge (relationship first, directions after) */
  .hv-collab {
    padding-bottom: var(--hv-space-8);
  }
  .hv-collab__card {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-left: 2px solid var(--hv-line-gold);
  }
  .hv-collab__body {
    margin-top: var(--hv-space-4);
    color: var(--hv-text-soft);
    max-width: 68ch;
  }

  .hv-join-roles {
    display: flex;
    flex-direction: column;
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-8);
  }
  .hv-join-role {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hv-space-8);
    padding: var(--hv-space-8);
    scroll-margin-top: 90px;
  }
  /* Title and kind tag (collaboration / long-term partner) share one line */
  .hv-join-role__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hv-space-4);
  }
  .hv-join-role__title {
    font-size: var(--hv-text-lg);
  }
  .hv-join-role__kind {
    border-color: var(--hv-line-gold);
    background: var(--hv-gold-wash);
    color: var(--hv-gold);
  }
  .hv-join-role__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--hv-space-2);
    font-size: var(--hv-text-sm);
    font-weight: 600;
    color: var(--hv-gold);
  }
  .hv-join-role__dot {
    color: var(--hv-text-faint);
  }
  .hv-join-role__desc {
    margin-top: var(--hv-space-4);
    color: var(--hv-text-soft);
    font-size: var(--hv-text-sm);
    max-width: 62ch;
  }
  .hv-join-role__skills {
    margin-top: var(--hv-space-3);
    font-size: var(--hv-text-xs);
    letter-spacing: 0.05em;
    color: var(--hv-text-faint);
    font-family: var(--hv-font-mono);
  }
  .hv-join-role__apply {
    flex-shrink: 0;
  }

  /* Publishing and business partnerships: directly after the collaboration directions, with no new block of whitespace */
  .hv-join-biz {
    padding-top: 0;
  }
  .hv-join-biz__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hv-space-8);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-left: 2px solid var(--hv-gold);
  }
  .hv-join-biz__body {
    margin-top: var(--hv-space-4);
    color: var(--hv-text-soft);
    max-width: 62ch;
  }
  .hv-join-biz__cta {
    flex-shrink: 0;
  }

  .hv-join-open {
    background: linear-gradient(
      180deg,
      transparent,
      rgba(11, 16, 29, 0.72) 18%
    );
    border-top: 1px solid var(--hv-line);
  }
  .hv-join-open__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .hv-join-open__body {
    margin-top: var(--hv-space-4);
    color: var(--hv-text-soft);
    max-width: 48ch;
  }
  .hv-join-open__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hv-space-4);
    margin-top: var(--hv-space-6);
  }

  @media (max-width: 860px) {
    .hv-join-role,
    .hv-join-biz__card {
      flex-direction: column;
      align-items: flex-start;
    }
    .hv-join-open__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
