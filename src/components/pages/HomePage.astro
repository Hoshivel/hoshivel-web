---
/*
  首頁 —— 星圖版式。
  重心：品牌 →《碎界》→ 支撐它的服務 → 開發動態 → 協作。
  節奏：Hero（題詞 ＋ 定位一句 ＋ Hoshivel 星圖）→ α 作品 → 服務 → β 動態
       → δ 協作。
  主視覺是那張星圖：作品即星、服務為環；其餘一律以留白與髮絲線立大氣。
  服務區不編拜耳字母——它不是作品，以環標記號另立一節；
  章節字母一律向 `lib/chapters.ts` 要，不在頁面裡寫死（否則首頁與獨立頁會漂移）。
*/
import Layout from "@/layouts/Layout.astro";
import WorksChart from "@/components/sky/WorksChart.astro";
import EntryCard from "@/components/EntryCard.astro";
import NewsCard from "@/components/NewsCard.astro";
import { useTranslations, localizedPath, type Locale } from "@/i18n/utils";
import { chapterMark } from "@/lib/chapters";
import { WORKS, SERVICES } from "@/lib/catalog";
import { getNewsForLocale } from "@/lib/news";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const latestNews = (await getNewsForLocale(locale)).slice(0, 3);
---

<Layout locale={locale}>
  <main id="main">
    <!-- Hero：夜空下的宣言 ＋ 星圖 -->
    <section class="hv-hero">
      <div class="hv-container hv-hero__inner">
        <div class="hv-hero__main">
          <p class="hv-eyebrow" data-reveal>{t("home.hero.eyebrow")}</p>
          <h1 class="hv-hero__title hv-display" data-reveal>
            {t("site.tagline")}
          </h1>
          {
            locale !== "en" && (
              <p class="hv-hero__latin" data-reveal>
                {t("site.taglineLatin")}
              </p>
            )
          }
          <p class="hv-hero__creed hv-display" data-reveal>{t("site.creed")}</p>
          <p class="hv-lead hv-hero__lead" data-reveal>{t("home.hero.lead")}</p>
          <div class="hv-hero__cta" data-reveal>
            <a class="hv-btn hv-btn--primary" href={localizedPath(locale, "/works#shattered-realms")}>
              {t("cta.sr")}
            </a>
            <a class="hv-btn hv-btn--ghost" href={localizedPath(locale, "/about")}>
              {t("cta.about")}
            </a>
          </div>
        </div>

        <div class="hv-hero__chart" data-reveal>
          <WorksChart locale={locale} />
        </div>
      </div>
      <div class="hv-container">
        <hr class="hv-rule" />
      </div>
    </section>

    <!-- α 作品 -->
    <section class="hv-section">
      <div class="hv-container">
        <div class="hv-section-head">
          <p class="hv-eyebrow" data-reveal>
            <span class="hv-eyebrow__mark">{chapterMark("works")}</span>
            {t("home.works.eyebrow")}
          </p>
          <h2 data-reveal>{t("home.works.title")}</h2>
          <p class="hv-lead" data-reveal>{t("home.works.lead")}</p>
        </div>
        <div class="hv-home-works">
          {WORKS.map((w) => <EntryCard locale={locale} entry={w} />)}
        </div>
      </div>
    </section>

    <!-- 服務（不編號：以環標記號另立一節） -->
    <section class="hv-section hv-home-services">
      <div class="hv-container">
        <div class="hv-section-head">
          <p class="hv-eyebrow" data-reveal>
            <span class="hv-eyebrow__ring" aria-hidden="true" />
            {t("home.services.eyebrow")}
          </p>
          <h2 data-reveal>{t("home.services.title")}</h2>
          <p class="hv-lead" data-reveal>{t("home.services.lead")}</p>
        </div>
        <div class="hv-home-works">
          {SERVICES.map((e) => <EntryCard locale={locale} entry={e} />)}
        </div>
      </div>
    </section>

    <!-- β 開發動態 -->
    <section class="hv-section hv-home-news">
      <div class="hv-container">
        <div class="hv-home-news__head">
          <div class="hv-section-head">
            <p class="hv-eyebrow" data-reveal>
              <span class="hv-eyebrow__mark">{chapterMark("news")}</span>
              {t("home.news.eyebrow")}
            </p>
            <h2 data-reveal>{t("home.news.title")}</h2>
            <p class="hv-lead" data-reveal>{t("home.news.lead")}</p>
          </div>
          <a class="hv-more" href={localizedPath(locale, "/news")} data-reveal>
            {t("cta.allNews")}
          </a>
        </div>
        <div class="hv-home-news__grid">
          {latestNews.map((post) => <NewsCard locale={locale} post={post} />)}
        </div>
      </div>
    </section>

    <!-- δ 協作 -->
    <section class="hv-section hv-home-join">
      <div class="hv-container">
        <div class="hv-home-join__card" data-reveal>
          <div>
            <p class="hv-eyebrow">
              <span class="hv-eyebrow__mark">{chapterMark("join")}</span>
              {t("nav.join")}
            </p>
            <h2 class="hv-home-join__title hv-display">{t("home.join.title")}</h2>
            <p class="hv-lead hv-home-join__lead">{t("home.join.lead")}</p>
          </div>
          <a class="hv-btn hv-btn--primary" href={localizedPath(locale, "/join")}>
            {t("cta.join")}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ---- Hero ---- */
  .hv-hero {
    padding-top: clamp(3.5rem, 10vh, 7rem);
  }
  .hv-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(3.5rem, 9vh, 6.5rem);
  }
  .hv-hero__title {
    margin-top: var(--hv-space-6);
    /* 題詞是門面第一句：大而不溢出文字欄（zh 9 字單行成立） */
    font-size: clamp(2.1rem, 4.6vw, 3.35rem);
    /* CJK 下 ch 單位失真，不設 max-width */
  }
  /* 題詞的拉丁書寫：等寬寬字距的一行金 */
  .hv-hero__latin {
    margin-top: var(--hv-space-4);
    font-family: var(--hv-font-mono);
    font-size: var(--hv-text-xs);
    letter-spacing: var(--hv-tracking-wider);
    color: var(--hv-gold);
  }
  /*
    定位一句：位階在題詞之下、導語之上——明體、星光色，以一道短金線起頭。
    不設 ch 寬限（CJK 下 ch ≈ 半字寬，限出來的行寬不是想要的那個）。
  */
  .hv-hero__creed {
    margin-top: var(--hv-space-8);
    font-size: var(--hv-text-lg);
    line-height: 1.55;
  }
  .hv-hero__creed::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: var(--hv-space-4);
    background: var(--hv-line-gold);
  }
  /*
    導語的斷行由字典裡的 `\n` 決定（見 `i18n/ui.ts` 的 `home.hero.lead`）：
    漢字可在任兩字之間斷開，交給瀏覽器會把《碎界 Shattered Realms》攔腰截斷。
    `pre-line` 只落實那幾個換行，行內仍正常回流——窄螢幕照樣自己再折。
  */
  .hv-hero__lead {
    margin-top: var(--hv-space-6);
    max-width: 46ch;
    white-space: pre-line;
    /*
      窄螢幕上第一段仍需再折一次；不平衡的話會掉出「略遊戲」這種三字孤行。
      桌機上三段各自單行，balance 無事可做——只在該出手時出手。
    */
    text-wrap: balance;
  }
  .hv-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hv-space-4);
    margin-top: var(--hv-space-8);
  }

  @media (max-width: 900px) {
    .hv-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--hv-space-12);
    }
  }

  /* ---- 作品 / 服務 ---- */
  .hv-home-works {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-12);
  }
  /* 服務緊接作品之後：同一段呼吸，不另起大留白 */
  .hv-home-services {
    padding-top: 0;
  }

  /* ---- 新聞：夜色帶（比站底深一階，上下髮絲線） ---- */
  .hv-home-news {
    background: linear-gradient(
      180deg,
      transparent,
      rgba(11, 16, 29, 0.72) 12%,
      rgba(11, 16, 29, 0.72) 88%,
      transparent
    );
    border-block: 1px solid var(--hv-line);
  }
  /*
    標題組與「查看所有動態」同一列；窄螢幕整條換行。
    （標題組多了導語之後，不換行的話收縮預算會全被它吃掉，
    連結會被壓成一字一行的細長條。）
  */
  .hv-home-news__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--hv-space-6);
  }
  .hv-home-news__head > .hv-more {
    flex-shrink: 0;
  }
  .hv-home-news__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-12);
  }
  @media (max-width: 980px) {
    .hv-home-news__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 合作 ---- */
  .hv-home-join {
    padding-top: 0;
  }
  .hv-home-join__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hv-space-8);
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--hv-line);
    border-left: 2px solid var(--hv-gold);
    border-radius: var(--hv-radius-lg);
    background: var(--hv-surface);
  }
  .hv-home-join__title {
    margin-top: var(--hv-space-4);
    font-size: var(--hv-text-xl);
  }
  .hv-home-join__lead {
    margin-top: var(--hv-space-3);
    max-width: 46ch;
  }
  @media (max-width: 760px) {
    .hv-home-join__card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
