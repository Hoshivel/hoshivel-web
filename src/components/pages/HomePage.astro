---
/*
  首頁 —— 星圖版式。
  節奏：Hero（宣言 ＋ Hoshivel 星圖）→ α 作品 → β 新聞 → 理念一句 → γ 同行。
  主視覺是那張星圖：作品即星，可點；其餘一律以留白與髮絲線立大氣。
*/
import Layout from "@/layouts/Layout.astro";
import WorksChart from "@/components/sky/WorksChart.astro";
import ProductCard from "@/components/ProductCard.astro";
import NewsCard from "@/components/NewsCard.astro";
import { useTranslations, localizedPath, bayer, type Locale } from "@/i18n/utils";
import { PRODUCTS } from "@/lib/products";
import { getNewsForLocale } from "@/lib/news";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const latestNews = (await getNewsForLocale(locale)).slice(0, 3);
---

<Layout locale={locale}>
  <main id="main">
    <!-- Hero：夜空下的宣言 ＋ 星圖 -->
    <section class="hv-hero">
      <div class="hv-container hv-hero__inner">
        <div class="hv-hero__main">
          <p class="hv-eyebrow" data-reveal>{t("home.hero.eyebrow")}</p>
          <h1 class="hv-hero__title hv-display" data-reveal>
            {t("home.hero.titleA")}<br />
            <span class="hv-hero__title-b">{t("home.hero.titleB")}</span>
          </h1>
          <p class="hv-lead hv-hero__lead" data-reveal>{t("home.hero.lead")}</p>
          <div class="hv-hero__cta" data-reveal>
            <a class="hv-btn hv-btn--primary" href={localizedPath(locale, "/works")}>
              {t("cta.works")}
            </a>
            <a class="hv-btn hv-btn--ghost" href={localizedPath(locale, "/about")}>
              {t("cta.about")}
            </a>
          </div>
        </div>

        <div class="hv-hero__chart" data-reveal>
          <WorksChart locale={locale} />
        </div>
      </div>
      <div class="hv-container">
        <hr class="hv-rule" />
      </div>
    </section>

    <!-- α 作品 -->
    <section class="hv-section">
      <div class="hv-container">
        <div class="hv-section-head">
          <p class="hv-eyebrow" data-reveal>
            <span class="hv-eyebrow__mark">{bayer(1)}</span>
            {t("home.works.eyebrow")}
          </p>
          <h2 data-reveal>{t("home.works.title")}</h2>
          <p class="hv-lead" data-reveal>{t("home.works.lead")}</p>
        </div>
        <div class="hv-home-works">
          {PRODUCTS.map((p) => <ProductCard locale={locale} product={p} />)}
        </div>
      </div>
    </section>

    <!-- β 新聞 -->
    <section class="hv-section hv-home-news">
      <div class="hv-container">
        <div class="hv-home-news__head">
          <div class="hv-section-head">
            <p class="hv-eyebrow" data-reveal>
              <span class="hv-eyebrow__mark">{bayer(2)}</span>
              {t("home.news.eyebrow")}
            </p>
            <h2 data-reveal>{t("home.news.title")}</h2>
          </div>
          <a class="hv-more" href={localizedPath(locale, "/news")} data-reveal>
            {t("cta.allNews")}
          </a>
        </div>
        <div class="hv-home-news__grid">
          {latestNews.map((post) => <NewsCard locale={locale} post={post} />)}
        </div>
      </div>
    </section>

    <!-- 理念一句（間奏，不編號） -->
    <section class="hv-section hv-home-belief">
      <div class="hv-container hv-narrow">
        <blockquote class="hv-home-belief__quote" data-reveal>
          <svg class="hv-home-belief__star" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 1 Q13 11 23 12 Q13 13 12 23 Q11 13 1 12 Q11 11 12 1 Z"></path>
          </svg>
          <p class="hv-display">{t("home.belief.quote")}</p>
          <footer>
            <a class="hv-home-belief__source" href={localizedPath(locale, "/about")}>
              {t("home.belief.source")}
            </a>
          </footer>
        </blockquote>
      </div>
    </section>

    <!-- γ 加入我們 -->
    <section class="hv-section hv-home-join">
      <div class="hv-container">
        <div class="hv-home-join__card" data-reveal>
          <div>
            <p class="hv-eyebrow">
              <span class="hv-eyebrow__mark">{bayer(3)}</span>
              {t("nav.join")}
            </p>
            <h2 class="hv-home-join__title hv-display">{t("home.join.title")}</h2>
            <p class="hv-lead hv-home-join__lead">{t("home.join.lead")}</p>
          </div>
          <a class="hv-btn hv-btn--primary" href={localizedPath(locale, "/join")}>
            {t("cta.join")}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ---- Hero ---- */
  .hv-hero {
    padding-top: clamp(3.5rem, 10vh, 7rem);
  }
  .hv-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(3.5rem, 9vh, 6.5rem);
  }
  .hv-hero__title {
    margin-top: var(--hv-space-6);
    /*
      兩欄版式下比通用 display 級數收兩階：以最長的一句（zh 12 字）
      能在文字欄內單行成立為準——否則尾行會只剩一兩個字。
    */
    font-size: clamp(2rem, 4vw, 2.75rem);
    /* CJK 下 ch 單位失真，不設 max-width */
  }
  .hv-hero__title-b {
    color: var(--hv-gold);
  }
  .hv-hero__lead {
    margin-top: var(--hv-space-6);
    max-width: 46ch;
  }
  .hv-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hv-space-4);
    margin-top: var(--hv-space-8);
  }

  @media (max-width: 900px) {
    .hv-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--hv-space-12);
    }
  }

  /* ---- 作品 ---- */
  .hv-home-works {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-12);
  }
  @media (max-width: 860px) {
    .hv-home-works {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 新聞：夜色帶（比站底深一階，上下髮絲線） ---- */
  .hv-home-news {
    background: linear-gradient(
      180deg,
      transparent,
      rgba(11, 16, 29, 0.72) 12%,
      rgba(11, 16, 29, 0.72) 88%,
      transparent
    );
    border-block: 1px solid var(--hv-line);
  }
  .hv-home-news__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--hv-space-6);
  }
  .hv-home-news__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-12);
  }
  @media (max-width: 980px) {
    .hv-home-news__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 理念一句 ---- */
  .hv-home-belief {
    padding-bottom: var(--hv-space-16);
  }
  .hv-home-belief__quote {
    text-align: center;
  }
  .hv-home-belief__star {
    width: 16px;
    height: 16px;
    margin-inline: auto;
    margin-bottom: var(--hv-space-6);
    fill: var(--hv-gold);
  }
  .hv-home-belief__quote > p {
    font-size: var(--hv-text-xl);
    line-height: 1.6;
  }
  /* 引號改用星圖線：一條淡出的橫線收尾 */
  .hv-home-belief__quote > p::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 1px;
    margin: var(--hv-space-6) auto 0;
    background: var(--hv-line-gold);
  }
  .hv-home-belief__source {
    display: inline-block;
    margin-top: var(--hv-space-4);
    font-size: var(--hv-text-sm);
    color: var(--hv-text-soft);
    transition: color var(--hv-dur-fast) var(--hv-ease-out);
  }
  .hv-home-belief__source::before {
    content: "—— ";
  }
  .hv-home-belief__source:hover {
    color: var(--hv-gold);
  }

  /* ---- 加入我們 ---- */
  .hv-home-join {
    padding-top: 0;
  }
  .hv-home-join__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hv-space-8);
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--hv-line);
    border-left: 2px solid var(--hv-gold);
    border-radius: var(--hv-radius-lg);
    background: var(--hv-surface);
  }
  .hv-home-join__title {
    margin-top: var(--hv-space-4);
    font-size: var(--hv-text-xl);
  }
  .hv-home-join__lead {
    margin-top: var(--hv-space-3);
    max-width: 46ch;
  }
  @media (max-width: 760px) {
    .hv-home-join__card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
