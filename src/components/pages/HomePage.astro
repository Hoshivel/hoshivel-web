---
/*
  Home page -- star chart layout.
  Emphasis: the brand, then Shattered Realms, then the services holding it up,
  then development news, then collaboration.
  Rhythm: hero (tagline + positioning line + the Hoshivel star chart) -> alpha
  works -> services -> beta news -> delta collaboration.
  The star chart is the key visual: works are stars, services are rings;
  everything else builds its air out of whitespace and hairlines.
  The services block carries no Bayer letter -- it is not a work, so it stands as
  its own section marked by a ring.
  Chapter letters always come from `lib/chapters.ts` and are never hardcoded in a
  page (otherwise the home page and the standalone pages drift apart).
*/
import Layout from "@/layouts/Layout.astro";
import WorksChart from "@/components/sky/WorksChart.astro";
import EntryCard from "@/components/EntryCard.astro";
import NewsCard from "@/components/NewsCard.astro";
import { useTranslations, localizedPath, type Locale } from "@/i18n/utils";
import { chapterMark } from "@/lib/chapters";
import { WORKS, SERVICES } from "@/lib/catalog";
import { getNewsForLocale } from "@/lib/news";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const latestNews = (await getNewsForLocale(locale)).slice(0, 3);
---

<Layout locale={locale}>
  <main id="main">
    <!-- Hero: the statement under the night sky, plus the star chart -->
    <section class="hv-hero">
      <div class="hv-container hv-hero__inner">
        <div class="hv-hero__main">
          <p class="hv-eyebrow" data-reveal>{t("home.hero.eyebrow")}</p>
          <h1 class="hv-hero__title hv-display" data-reveal>
            {t("site.tagline")}
          </h1>
          {
            locale !== "en" && (
              <p class="hv-hero__latin" data-reveal>
                {t("site.taglineLatin")}
              </p>
            )
          }
          <p class="hv-hero__creed hv-display" data-reveal>{t("home.hero.creed")}</p>
          <p class="hv-lead hv-hero__lead" data-reveal>{t("home.hero.lead")}</p>
          <div class="hv-hero__cta" data-reveal>
            <a class="hv-btn hv-btn--primary" href={localizedPath(locale, "/works#shattered-realms")}>
              {t("cta.sr")}
            </a>
            <a class="hv-btn hv-btn--ghost" href={localizedPath(locale, "/about")}>
              {t("cta.about")}
            </a>
          </div>
        </div>

        <div class="hv-hero__chart" data-reveal>
          <WorksChart locale={locale} />
        </div>
      </div>
      <div class="hv-container">
        <hr class="hv-rule" />
      </div>
    </section>

    <!-- alpha: works -->
    <section class="hv-section">
      <div class="hv-container">
        <div class="hv-section-head">
          <p class="hv-eyebrow" data-reveal>
            <span class="hv-eyebrow__mark">{chapterMark("works")}</span>
            {t("home.works.eyebrow")}
          </p>
          <h2 data-reveal>{t("home.works.title")}</h2>
          <p class="hv-lead" data-reveal>{t("home.works.lead")}</p>
        </div>
        <div class="hv-home-works">
          {WORKS.map((w) => <EntryCard locale={locale} entry={w} />)}
        </div>
      </div>
    </section>

    <!-- Services (unnumbered: their own section, marked by a ring) -->
    <section class="hv-section hv-home-services">
      <div class="hv-container">
        <div class="hv-section-head">
          <p class="hv-eyebrow" data-reveal>
            <span class="hv-eyebrow__ring" aria-hidden="true" />
            {t("home.services.eyebrow")}
          </p>
          <h2 data-reveal>{t("home.services.title")}</h2>
          <p class="hv-lead" data-reveal>{t("home.services.lead")}</p>
        </div>
        <div class="hv-home-works">
          {SERVICES.map((e) => <EntryCard locale={locale} entry={e} />)}
        </div>
      </div>
    </section>

    <!-- beta: development news -->
    <section class="hv-section hv-home-news">
      <div class="hv-container">
        <div class="hv-home-news__head">
          <div class="hv-section-head">
            <p class="hv-eyebrow" data-reveal>
              <span class="hv-eyebrow__mark">{chapterMark("news")}</span>
              {t("home.news.eyebrow")}
            </p>
            <h2 data-reveal>{t("home.news.title")}</h2>
            <p class="hv-lead" data-reveal>{t("home.news.lead")}</p>
          </div>
          <a class="hv-more" href={localizedPath(locale, "/news")} data-reveal>
            {t("cta.allNews")}
          </a>
        </div>
        <div class="hv-home-news__grid">
          {latestNews.map((post) => <NewsCard locale={locale} post={post} />)}
        </div>
      </div>
    </section>

    <!-- delta: collaboration -->
    <section class="hv-section hv-home-join">
      <div class="hv-container">
        <div class="hv-home-join__card" data-reveal>
          <div>
            <p class="hv-eyebrow">
              <span class="hv-eyebrow__mark">{chapterMark("join")}</span>
              {t("nav.join")}
            </p>
            <h2 class="hv-home-join__title hv-display">{t("home.join.title")}</h2>
            <p class="hv-lead hv-home-join__lead">{t("home.join.lead")}</p>
          </div>
          <a class="hv-btn hv-btn--primary" href={localizedPath(locale, "/join")}>
            {t("cta.join")}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ---- Hero ---- */
  .hv-hero {
    padding-top: clamp(3.5rem, 10vh, 7rem);
  }
  .hv-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(3.5rem, 9vh, 6.5rem);
  }
  .hv-hero__title {
    margin-top: var(--hv-space-6);
    /* Keep all four locales one step below the generic display scale in this two-column hero. */
    font-size: clamp(1.95rem, 4.1vw, 3rem);
    /* The ch unit is unreliable for CJK, so no max-width here */
  }
  /* A restrained warm starlight distinguishes the English homepage without a solid gold block. */
  :global(html[lang="en"]) .hv-hero__title {
    color: var(--hv-gold-soft);
    color: color-mix(in srgb, var(--hv-starlight) 68%, var(--hv-gold));
  }
  /* The tagline in Latin: one gold line, monospaced and widely tracked */
  .hv-hero__latin {
    margin-top: var(--hv-space-4);
    font-family: var(--hv-font-mono);
    font-size: var(--hv-text-xs);
    letter-spacing: var(--hv-tracking-wider);
    color: var(--hv-gold);
  }
  /*
    Positioning line: ranked below the tagline and above the lead -- serif, in
    starlight, opened by a short gold rule.
    No ch-based width limit (for CJK one ch is about half a glyph, so the
    resulting measure is not the one intended).
  */
  .hv-hero__creed {
    margin-top: var(--hv-space-8);
    font-size: var(--hv-text-lg);
    line-height: 1.55;
  }
  .hv-hero__creed::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: var(--hv-space-4);
    background: var(--hv-line-gold);
  }
  /*
    The lead's line breaks come from the `\n` in the dictionary (see
    `home.hero.lead` in `i18n/ui.ts`): Han text may break between any two
    characters, so leaving it to the browser cuts 《碎界 Shattered Realms》 in half.
    `pre-line` only honors those explicit breaks; the lines still reflow normally,
    so a narrow screen wraps further on its own.
  */
  .hv-hero__lead {
    margin-top: var(--hv-space-6);
    max-width: 46ch;
    white-space: pre-line;
    /*
      On a narrow screen the first paragraph still wraps again, and without
      balancing it drops a three-character orphan line such as 「略遊戲」.
      On desktop all three paragraphs fit one line each and balance has nothing
      to do -- it only acts when it is needed.
    */
    text-wrap: balance;
  }
  .hv-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hv-space-4);
    margin-top: var(--hv-space-8);
  }

  @media (max-width: 900px) {
    .hv-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--hv-space-12);
    }
  }

  @media (min-width: 901px) {
    /* The Traditional Chinese face is wider; preserve the complete line while two columns fit. */
    :global(html[lang="zh-Hant"]) .hv-hero__title {
      white-space: nowrap;
    }
  }

  /* ---- Works / services ---- */
  .hv-home-works {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-12);
  }
  /* Services follow works directly: one breath, no new block of whitespace */
  .hv-home-services {
    padding-top: 0;
  }

  /* ---- News: night band (a step darker than the page base, hairlines above and below) ---- */
  .hv-home-news {
    background: linear-gradient(
      180deg,
      transparent,
      rgba(11, 16, 29, 0.72) 12%,
      rgba(11, 16, 29, 0.72) 88%,
      transparent
    );
    border-block: 1px solid var(--hv-line);
  }
  /*
    The heading group and the "view all news" link share a row, and the whole
    row wraps on a narrow screen.
    (Once the heading group gained a lead paragraph, refusing to wrap let it eat
    the entire shrink budget, squeezing the link into a sliver one character wide.)
  */
  .hv-home-news__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--hv-space-6);
  }
  .hv-home-news__head > .hv-more {
    flex-shrink: 0;
  }
  .hv-home-news__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--hv-space-6);
    margin-top: var(--hv-space-12);
  }
  @media (max-width: 980px) {
    .hv-home-news__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Join ---- */
  .hv-home-join {
    padding-top: 0;
  }
  .hv-home-join__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hv-space-8);
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--hv-line);
    border-left: 2px solid var(--hv-gold);
    border-radius: var(--hv-radius-lg);
    background: var(--hv-surface);
  }
  .hv-home-join__title {
    margin-top: var(--hv-space-4);
    font-size: var(--hv-text-xl);
  }
  .hv-home-join__lead {
    margin-top: var(--hv-space-3);
    max-width: 46ch;
  }
  @media (max-width: 760px) {
    .hv-home-join__card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
