---
/*
  關於頁 —— 我們是誰 → 現在正在做的事 → 我們相信（五項）→ 聯繫。
  夜面敘事：左標題右正文；現況以圖版卡標出；完整主張以編號長文呈現。
*/
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import Mark from "@/components/brand/Mark.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { useTranslations, type Locale } from "@/i18n/utils";
import { chapterMark } from "@/lib/chapters";
import { CONTACT_EMAIL } from "@/lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const paragraph = (text: string) => ({ text, strong: false, prefix: "" });
const emphasis = (text: string, prefix = "") => ({ text, strong: true, prefix });
const values = [
  {
    name: t("about.v1.name"),
    blocks: [
      paragraph(t("about.v1.p1")),
      paragraph(t("about.v1.p2")),
      paragraph(t("about.v1.p3")),
      emphasis(t("about.v1.quote")),
    ],
  },
  {
    name: t("about.v2.name"),
    blocks: [
      paragraph(t("about.v2.p1")),
      paragraph(t("about.v2.p2")),
      paragraph(t("about.v2.p3")),
    ],
  },
  {
    name: t("about.v3.name"),
    blocks: [
      paragraph(t("about.v3.p1")),
      paragraph(t("about.v3.p2")),
      emphasis(t("about.v3.quote")),
      paragraph(t("about.v3.p3")),
    ],
  },
  {
    name: t("about.v4.name"),
    blocks: [
      paragraph(t("about.v4.p1")),
      paragraph(t("about.v4.p2")),
      paragraph(t("about.v4.p3")),
      emphasis(t("about.v4.quote"), t("about.v4.quote_prefix")),
      paragraph(t("about.v4.p4")),
    ],
  },
  {
    name: t("about.v5.name"),
    blocks: [
      paragraph(t("about.v5.p1")),
      paragraph(t("about.v5.p2")),
      paragraph(t("about.v5.p3")),
      emphasis(t("about.v5.quote1")),
      emphasis(t("about.v5.quote2")),
    ],
  },
];
---

<Layout locale={locale} title={t("nav.about")} description={t("about.lead")}>
  <main id="main">
    <PageHero
      mark={chapterMark("about")}
      eyebrow={t("about.eyebrow")}
      title={t("about.title")}
      lead={t("about.lead")}
    />

    <!-- 我們是誰 -->
    <section class="hv-section hv-about-who" aria-labelledby="about-who">
      <div class="hv-container hv-about-who__grid">
        <h2 id="about-who" class="hv-about__h2 hv-display" data-reveal>
          {t("about.who.title")}
        </h2>
        <div class="hv-about-who__body">
          <p data-reveal>{t("about.who.body1")}</p>
          <p data-reveal>{t("about.who.body2")}</p>
        </div>
      </div>
    </section>

    <!-- 現在正在做的事：圖版卡 -->
    <section class="hv-about-now" aria-labelledby="about-now">
      <div class="hv-container">
        <div class="hv-about-now__card" data-reveal>
          <Mark size={46} />
          <div>
            <h2 id="about-now" class="hv-about__h2 hv-display">
              {t("about.now.title")}
            </h2>
            <p class="hv-about-now__body">{t("about.now.body")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 我們相信：五項完整主張 -->
    <section class="hv-section" aria-labelledby="about-values">
      <div class="hv-container">
        <h2 id="about-values" class="hv-about__h2 hv-display" data-reveal>
          {t("about.values.title")}
        </h2>
        <div class="hv-about-values">
          {
            values.map((v, i) => (
              <article class="hv-about-values__item" data-reveal>
                <span class="hv-catalog hv-about-values__index" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="hv-about-values__content">
                  <h3 class="hv-about-values__name hv-display">{v.name}</h3>
                  <div class="hv-about-values__body">
                    {v.blocks.map((block) => (
                      <p class={`hv-about-values__block${block.strong ? " is-emphasis" : ""}`}>
                        {block.prefix}
                        {block.strong ? <strong>{block.text}</strong> : block.text}
                      </p>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <p class="hv-about-values__closing hv-display" data-reveal>
          <strong>{t("about.values.closing")}</strong>
        </p>
      </div>
    </section>

    <!-- 聯繫：夜色帶收尾 -->
    <section class="hv-section hv-about-contact" aria-labelledby="about-contact">
      <div class="hv-container hv-narrow hv-about-contact__inner">
        <h2 id="about-contact" class="hv-about__h2 hv-display" data-reveal>
          {t("about.contact.title")}
        </h2>
        <p class="hv-lead" data-reveal>{t("about.contact.body")}</p>
        <div class="hv-about-contact__cta" data-reveal>
          <a class="hv-btn hv-btn--primary" href={`mailto:${CONTACT_EMAIL}`}>
            {CONTACT_EMAIL}
          </a>
        </div>

        <!-- 社群入口：四個平台一列圖版籤 -->
        <div data-reveal>
          <p class="hv-about-contact__social-label">
            {t("about.contact.social")}
          </p>
          <SocialLinks
            locale={locale}
            variant="boxed"
            class="hv-about-contact__social"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hv-about__h2 {
    font-size: var(--hv-text-xl);
  }

  /* 我們是誰：左標題右正文 */
  .hv-about-who__grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(1.5rem, 6vw, 5rem);
  }
  .hv-about-who__body {
    display: flex;
    flex-direction: column;
    gap: var(--hv-space-6);
    color: var(--hv-text-soft);
    font-size: var(--hv-text-base);
    max-width: 62ch;
  }

  /* 現在正在做的事：星盤 + 圖版卡 */
  .hv-about-now__card {
    display: flex;
    align-items: flex-start;
    gap: var(--hv-space-8);
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--hv-line);
    border-radius: var(--hv-radius-lg);
    background: var(--hv-surface);
  }
  .hv-about-now__body {
    margin-top: var(--hv-space-4);
    color: var(--hv-text-soft);
    max-width: 58ch;
  }

  /* 我們相信：五項長文，每項沿同一條編號軸閱讀 */
  .hv-about-values {
    display: grid;
    max-width: 58rem;
    margin-top: var(--hv-space-8);
  }
  .hv-about-values__item {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    border-top: 1px solid var(--hv-line-strong);
  }
  .hv-about-values__item:last-child {
    border-bottom: 1px solid var(--hv-line-strong);
  }
  .hv-about-values__index {
    padding-top: 0.35rem;
    color: var(--hv-gold);
  }
  .hv-about-values__name {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }
  .hv-about-values__body {
    display: grid;
    gap: var(--hv-space-4);
    margin-top: var(--hv-space-6);
  }
  .hv-about-values__block {
    margin: 0;
    color: var(--hv-text-soft);
    font-size: var(--hv-text-base);
    line-height: 1.9;
  }
  .hv-about-values__block.is-emphasis {
    padding-left: var(--hv-space-4);
    border-left: 1px solid var(--hv-gold);
    color: var(--hv-text);
    font-family: var(--hv-font-display);
    font-size: clamp(1.08rem, 2.1vw, 1.3rem);
    letter-spacing: 0.03em;
  }
  .hv-about-values__block strong {
    font-weight: 650;
  }
  .hv-about-values__closing {
    max-width: 58rem;
    margin-top: var(--hv-space-12);
    color: var(--hv-gold);
    font-size: var(--hv-text-lg);
    letter-spacing: 0.08em;
    text-align: right;
  }

  /* 聯繫 */
  .hv-about-contact {
    background: linear-gradient(
      180deg,
      transparent,
      rgba(11, 16, 29, 0.72) 20%
    );
    border-top: 1px solid var(--hv-line);
  }
  .hv-about-contact__inner {
    text-align: center;
  }
  .hv-about-contact .hv-lead {
    margin-top: var(--hv-space-4);
  }
  .hv-about-contact__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--hv-space-4);
    margin-top: var(--hv-space-8);
  }
  .hv-about-contact__social-label {
    margin-top: var(--hv-space-12);
    font-size: var(--hv-text-xs);
    letter-spacing: var(--hv-tracking-wide);
    color: var(--hv-text-faint);
  }
  .hv-about-contact__social {
    margin-top: var(--hv-space-4);
  }

  @media (max-width: 860px) {
    .hv-about-who__grid {
      grid-template-columns: 1fr;
    }
    .hv-about-values__item {
      grid-template-columns: 1fr;
      gap: var(--hv-space-3);
    }
    .hv-about-values__index {
      padding-top: 0;
    }
    .hv-about-values__closing {
      text-align: left;
    }
    .hv-about-now__card {
      flex-direction: column;
      gap: var(--hv-space-6);
    }
  }
</style>
