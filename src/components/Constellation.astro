---
/*
  星座裝飾 —— 純 SVG 靜態星圖（門戶唯一的氛圍元素）。
  手繪星點＋細連線，構成抽象的「星帆」：左低右高的帆形航線。
  僅 2 顆星以 CSS 呼吸微光（reduced-motion 時關閉）；aria-hidden 純裝飾。
  置於 Hero 背景，邊緣以 mask 淡出。
*/
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// 星點（viewBox 1200×620）：帆形主星座＋外圍散星
interface Star {
  x: number;
  y: number;
  r: number;
  bright?: boolean;
  /** 呼吸微光的起始延遲（秒）；undefined = 不動。 */
  pulseDelay?: number;
}
const sail: Star[] = [
  { x: 330, y: 430, r: 2.2, bright: true }, // 帆腳（船）
  { x: 470, y: 350, r: 1.6 },
  { x: 620, y: 300, r: 2.6, bright: true, pulseDelay: 0 }, // 主星
  { x: 760, y: 240, r: 1.7 },
  { x: 905, y: 150, r: 2.1, bright: true, pulseDelay: 3.2 }, // 桅頂星
  { x: 585, y: 175, r: 1.4 }, // 帆上緣
  { x: 415, y: 255, r: 1.5 },
];
// 帆形連線：底邊（航線）＋上緣（帆緣），共享首尾
const lineA = sail.slice(0, 5); // 330,430 → 905,150
const lineB = [sail[0]!, sail[6]!, sail[5]!, sail[4]!]; // 回到桅頂
const scatter: Star[] = [
  { x: 120, y: 180, r: 1.2 },
  { x: 205, y: 505, r: 1.4 },
  { x: 540, y: 520, r: 1.1 },
  { x: 1005, y: 400, r: 1.5 },
  { x: 1105, y: 250, r: 1.2 },
  { x: 985, y: 60, r: 1.3 },
  { x: 705, y: 495, r: 1.2 },
  { x: 80, y: 350, r: 1.1 },
];
const toPoints = (pts: { x: number; y: number }[]) =>
  pts.map((p) => `${p.x},${p.y}`).join(" ");
---

<svg
  class:list={["hv-constellation", className]}
  viewBox="0 0 1200 620"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <polyline points={toPoints(lineA)} class="hv-constellation__line"></polyline>
  <polyline points={toPoints(lineB)} class="hv-constellation__line"></polyline>
  {
    [...sail, ...scatter].map((s) => (
      <circle
        cx={s.x}
        cy={s.y}
        r={s.r}
        class:list={[
          "hv-constellation__star",
          { "is-bright": s.bright, "is-pulse": s.pulseDelay !== undefined },
        ]}
        style={
          s.pulseDelay !== undefined
            ? `animation-delay: ${s.pulseDelay}s`
            : undefined
        }
      />
    ))
  }
</svg>

<style>
  .hv-constellation {
    width: 100%;
    height: 100%;
    /* 邊緣淡出，讓星圖融進底色 */
    -webkit-mask-image: radial-gradient(
      75% 75% at 55% 42%,
      rgba(0, 0, 0, 0.9),
      transparent 78%
    );
    mask-image: radial-gradient(
      75% 75% at 55% 42%,
      rgba(0, 0, 0, 0.9),
      transparent 78%
    );
  }
  .hv-constellation__line {
    stroke: var(--hv-constellation-line);
    stroke-width: 1;
  }
  .hv-constellation__star {
    fill: var(--hv-star);
    opacity: 0.55;
  }
  .hv-constellation__star.is-bright {
    opacity: 0.95;
  }
  /* 呼吸微光：唯二會動的星（幅度小、週期長；delay 由 inline style 指定） */
  .hv-constellation__star.is-pulse {
    animation: hv-twinkle 7s var(--hv-ease-in-out) infinite;
  }
  @keyframes hv-twinkle {
    0%,
    100% {
      opacity: 0.95;
    }
    50% {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hv-constellation__star.is-pulse {
      animation: none;
    }
  }
</style>
