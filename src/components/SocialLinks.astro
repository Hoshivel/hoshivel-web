---
/*
  社群入口 —— X / YouTube / GitHub / Reddit（帳號一律 hoshivel；來源見 lib/site.ts）。
  圖示為內聯 SVG（零外部請求、無圖檔），一律 currentColor：紙面走墨色、
  墨面（footer）走反白，hover 才落到朱。

  兩種面貌：
  · list（預設，站尾欄用）圖示＋平台名，一行一個
  · row（關於頁用）只有圖示的一列，帳號名放 title / aria-label
*/
import { useTranslations, type Locale } from "@/i18n/utils";
import { SOCIAL_LINKS, type SocialId } from "@/lib/site";

interface Props {
  locale: Locale;
  variant?: "list" | "row";
  /** 墨面（footer）上的反白配色。 */
  onInk?: boolean;
  class?: string;
}
const {
  locale,
  variant = "list",
  onInk = false,
  class: className,
} = Astro.props;
const t = useTranslations(locale);

/** 各平台官方標記（24×24 viewBox，單一 path，fill=currentColor）。 */
const ICONS: Record<SocialId, string> = {
  x: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zM17.61 20.644h2.039L6.486 3.24H4.298z",
  youtube:
    "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
  github:
    "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12z",
  reddit:
    "M12 0C5.373 0 0 5.373 0 12c0 3.204 1.256 6.114 3.301 8.264l-1.94 1.94A.6.6 0 0 0 1.786 23.2H12c6.627 0 12-5.373 12-12S18.627 0 12 0zm5.42 6.68a1.68 1.68 0 0 1 1.144 2.91 2.8 2.8 0 0 1 1.44 2.45c0 3.16-3.582 5.72-8.004 5.72s-8.004-2.56-8.004-5.72a2.8 2.8 0 0 1 4.42-2.28c1.2-.79 2.79-1.29 4.54-1.36l1.03-4.34a.6.6 0 0 1 .71-.45l3.06.66a1.68 1.68 0 0 1 1.34-.68 1.68 1.68 0 0 1 0 3.36 1.68 1.68 0 0 1-1.676-1.62l-2.65-.57-.87 3.66c1.7.09 3.24.59 4.41 1.36a2.79 2.79 0 0 1 1.55-.47zM8.7 12.75a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88zm6.6 0a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88zm-6.87 4.62a.48.48 0 0 0-.06.68c.9.9 2.35 1.34 3.63 1.34s2.73-.44 3.63-1.34a.48.48 0 1 0-.68-.68c-.63.63-1.79 1.02-2.95 1.02s-2.32-.39-2.95-1.02a.48.48 0 0 0-.62-.06z",
};
---

<ul class:list={["hv-social", `hv-social--${variant}`, { "on-ink": onInk }, className]}>
  {
    SOCIAL_LINKS.map((s) => (
      <li>
        <a
          class="hv-social__link"
          href={s.url}
          target="_blank"
          rel="noopener"
          title={`${s.label} · ${s.handle}`}
          aria-label={`${s.label} · ${s.handle}`}
        >
          <svg
            class="hv-social__icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d={ICONS[s.id]} />
          </svg>
          {variant === "list" && <span class="hv-social__label">{s.label}</span>}
          <span class="hv-visually-hidden">{t("a11y.external")}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .hv-social {
    list-style: none;
    padding: 0;
  }
  .hv-social__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--hv-text-sm);
    color: var(--hv-ink-soft);
    transition:
      color var(--hv-dur-fast) var(--hv-ease-out),
      border-color var(--hv-dur-fast) var(--hv-ease-out);
  }
  .hv-social__link:hover {
    color: var(--hv-vermilion);
  }
  .hv-social__icon {
    flex-shrink: 0;
  }

  /* list：站尾欄——一行一個平台，與相鄰的 footer 連結同節奏 */
  .hv-social--list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* row：關於頁——只有圖示的一列，方框髮絲籤 */
  .hv-social--row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--hv-space-3);
  }
  .hv-social--row .hv-social__link {
    padding: 0.6rem;
    border: 1px solid var(--hv-hairline-strong);
    border-radius: var(--hv-radius);
    color: var(--hv-ink);
  }
  .hv-social--row .hv-social__link:hover {
    border-color: var(--hv-vermilion);
    color: var(--hv-vermilion);
  }

  /* 墨面（footer）反白：hover 提亮而非落朱（朱在深底上不夠清楚） */
  .hv-social.on-ink .hv-social__link {
    color: var(--hv-paper-on-ink);
    opacity: 0.85;
    transition: opacity var(--hv-dur-fast) var(--hv-ease-out);
  }
  .hv-social.on-ink .hv-social__link:hover {
    color: #fff;
    opacity: 1;
  }
</style>
