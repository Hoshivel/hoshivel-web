---
/*
  Hoshivel star chart -- the plate in the home hero (the portal's key visual).

  A small star chart: a coordinate grid, constellation lines, catalog ticks. The
  brightest things on it are **works** (clickable, jumping straight to that
  work's section); the ring markers are **services** -- not works, but the ground
  the works rest on, which is why they are drawn as orbit rings rather than rays.

  The constellation lines are drawn in on load via stroke-dashoffset (reduced
  motion jumps straight to the finished state).
  The grid and the scattered stars are aria-hidden; only the work and service
  markers are real links.
*/
import { useTranslations, localizedPath, type Locale } from "@/i18n/utils";
import { WORKS, SERVICES } from "@/lib/catalog";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/** Constellation nodes (viewBox 620x520). */
const NODES = [
  { x: 96, y: 402 },
  { x: 196, y: 330 }, // 服務位（環標）
  { x: 286, y: 366 },
  { x: 392, y: 168 }, // 作品位 1
  { x: 498, y: 226 },
  { x: 452, y: 372 }, // 作品位 2（新增作品時自動點亮）
  { x: 540, y: 104 },
] as const;

/** Node index of each work star and which side its label sits on. */
const WORK_SLOTS = [
  { node: 3, anchor: "end" as const },
  { node: 5, anchor: "start" as const },
];
/** Node index of each service ring marker. */
const SERVICE_SLOTS = [{ node: 1, anchor: "start" as const }];

type Marker = {
  id: string;
  name: string;
  label: string;
  href: string;
  accentVar: string;
  x: number;
  y: number;
  labelX: number;
  anchor: "start" | "end";
  node: number;
};

const place = (
  entries: typeof WORKS,
  slots: { node: number; anchor: "start" | "end" }[],
  label: (e: (typeof WORKS)[number]) => string,
): Marker[] =>
  entries.slice(0, slots.length).map((e, i) => {
    const slot = slots[i]!;
    const pos = NODES[slot.node]!;
    return {
      id: e.id,
      name: t(e.nameKey),
      label: label(e),
      href: localizedPath(locale, `/works#${e.id}`),
      accentVar: e.accentVar,
      x: pos.x,
      y: pos.y,
      labelX: pos.x + (slot.anchor === "end" ? -17 : 17),
      anchor: slot.anchor,
      node: slot.node,
    };
  });

const works = place(WORKS, WORK_SLOTS, (e) => e.catalog ?? "");
const services = place(SERVICES, SERVICE_SLOTS, () => t("label.service"));
const marked = new Set([...works, ...services].map((m) => m.node));

/** The lines: one closed shape plus an arm reaching out of it. */
const FIGURE = [0, 1, 2, 5, 4, 3, 1];
const ARM = [4, 6];
const toPoints = (idx: readonly number[]) =>
  idx.map((i) => `${NODES[i]!.x},${NODES[i]!.y}`).join(" ");

/** Scattered stars (background stars that are not on the lines). */
const FIELD = [
  { x: 148, y: 128, r: 1.6 },
  { x: 322, y: 86, r: 1.2 },
  { x: 566, y: 300, r: 1.5 },
  { x: 236, y: 470, r: 1.3 },
  { x: 372, y: 470, r: 1.1 },
  { x: 64, y: 226, r: 1.4 },
  { x: 592, y: 424, r: 1.2 },
  { x: 462, y: 62, r: 1.3 },
  { x: 118, y: 302, r: 1.1 },
  { x: 540, y: 176, r: 1.2 },
];
---

<figure class="hv-chart">
  <svg class="hv-chart__svg" viewBox="0 0 620 520" fill="none">
    <!-- Coordinate grid -->
    <g class="hv-chart__grid" aria-hidden="true">
      {
        [155, 310, 465].map((x) => (
          <line x1={x} y1="4" x2={x} y2="516" stroke-dasharray="2 9" />
        ))
      }
      {
        [130, 260, 390].map((y) => (
          <line x1="4" y1={y} x2="616" y2={y} stroke-dasharray="2 9" />
        ))
      }
    </g>

    <!-- Plate ticks: measuring marks along the bottom and left edges (the border of a copperplate chart) -->
    <g class="hv-chart__ticks" aria-hidden="true">
      {
        Array.from({ length: 15 }, (_, i) => (i + 1) * 38.75).map((x) => (
          <line x1={x} y1="520" x2={x} y2={(x / 38.75) % 4 === 0 ? 508 : 514} />
        ))
      }
      {
        Array.from({ length: 12 }, (_, i) => (i + 1) * 40).map((y) => (
          <line x1="0" y1={y} x2={(y / 40) % 3 === 0 ? 12 : 6} y2={y} />
        ))
      }
    </g>

    <!-- Constellation lines (drawn in on load) -->
    <g class="hv-chart__lines" aria-hidden="true">
      <polyline points={toPoints(FIGURE)} class="hv-chart__line"></polyline>
      <polyline
        points={toPoints(ARM)}
        class="hv-chart__line hv-chart__line--arm"></polyline>
    </g>

    <!-- Scattered stars -->
    <g class="hv-chart__field" aria-hidden="true">
      {FIELD.map((s) => <circle cx={s.x} cy={s.y} r={s.r} />)}
    </g>

    <!-- Unlabeled nodes on the lines -->
    <g class="hv-chart__nodes" aria-hidden="true">
      {
        NODES.map((n, i) =>
          marked.has(i) ? null : <circle cx={n.x} cy={n.y} r="2.6" />,
        )
      }
    </g>

    <!-- Works: bright stars -->
    {
      works.map((w) => (
        <a
          class="hv-chart__marker"
          href={w.href}
          style={`--star-accent: var(${w.accentVar})`}
        >
          <circle class="hv-chart__halo" cx={w.x} cy={w.y} r="16" />
          <circle class="hv-chart__ring" cx={w.x} cy={w.y} r="10.5" />
          <circle class="hv-chart__core" cx={w.x} cy={w.y} r="4.4" />
          <text
            class="hv-chart__name"
            x={w.labelX}
            y={w.y - 2}
            text-anchor={w.anchor}
          >
            {w.name}
          </text>
          <text
            class="hv-chart__tag"
            x={w.labelX}
            y={w.y + 15}
            text-anchor={w.anchor}
          >
            {w.label}
          </text>
        </a>
      ))
    }

    <!-- Services: ring markers (not rays -- a service holds the stars up, it does not compete with them for brightness) -->
    {
      services.map((s) => (
        <a
          class="hv-chart__marker is-service"
          href={s.href}
          style={`--star-accent: var(${s.accentVar})`}
        >
          <circle class="hv-chart__ring is-outer" cx={s.x} cy={s.y} r="11.5" />
          <circle class="hv-chart__ring" cx={s.x} cy={s.y} r="6.5" />
          <circle class="hv-chart__core is-small" cx={s.x} cy={s.y} r="2.4" />
          <text
            class="hv-chart__name is-small"
            x={s.labelX}
            y={s.y - 2}
            text-anchor={s.anchor}
          >
            {s.name}
          </text>
          <text
            class="hv-chart__tag"
            x={s.labelX}
            y={s.y + 14}
            text-anchor={s.anchor}
          >
            {s.label}
          </text>
        </a>
      ))
    }
  </svg>

  <figcaption class="hv-chart__caption">
    <span class="hv-chart__title">{t("home.chart.title")}</span>
    <span class="hv-chart__legend">
      <span class="hv-chart__legend-item">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2 Q13 11 22 12 Q13 13 12 22 Q11 13 2 12 Q11 11 12 2 Z" />
        </svg>
        {t("label.work")}
      </span>
      <span class="hv-chart__legend-item is-service">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke-width="2" />
          <circle cx="12" cy="12" r="2.4" stroke="none" />
        </svg>
        {t("label.service")}
      </span>
    </span>
  </figcaption>
</figure>

<style>
  .hv-chart {
    position: relative;
    padding: var(--hv-space-4) var(--hv-space-4) var(--hv-space-3);
    border: 1px solid var(--hv-line);
    border-radius: var(--hv-radius-lg);
    background: linear-gradient(
      160deg,
      rgba(14, 20, 36, 0.6),
      rgba(8, 11, 21, 0.25)
    );
  }
  /* Corner ticks of the plate */
  .hv-chart::before,
  .hv-chart::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--hv-line-gold);
    pointer-events: none;
  }
  .hv-chart::before {
    top: 6px;
    left: 6px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .hv-chart::after {
    right: 6px;
    bottom: 6px;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  .hv-chart__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hv-chart__grid line,
  .hv-chart__ticks line {
    stroke: var(--hv-line-strong);
    stroke-width: 1;
  }
  .hv-chart__field circle {
    fill: var(--hv-star-dim);
  }
  .hv-chart__nodes circle {
    fill: var(--hv-star);
    opacity: 0.75;
  }

  /* Lines: drawn in (the total length is set generously so one pass covers it) */
  .hv-chart__line {
    stroke: var(--hv-line-strong);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    animation: hv-chart-draw 1.9s var(--hv-ease-out) 0.25s forwards;
  }
  .hv-chart__line--arm {
    animation-delay: 1.1s;
  }
  @keyframes hv-chart-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Markers (shared by work stars and service ring markers) */
  .hv-chart__marker {
    cursor: pointer;
  }
  .hv-chart__halo {
    fill: var(--star-accent);
    opacity: 0.14;
    transition: opacity var(--hv-dur) var(--hv-ease-out);
  }
  .hv-chart__ring {
    fill: none;
    stroke: var(--star-accent);
    stroke-width: 1;
    opacity: 0.55;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity var(--hv-dur) var(--hv-ease-out),
      transform var(--hv-dur) var(--hv-ease-out);
  }
  .hv-chart__ring.is-outer {
    opacity: 0.3;
    stroke-dasharray: 3 5;
  }
  .hv-chart__core {
    fill: var(--hv-star);
    transition: fill var(--hv-dur-fast) var(--hv-ease-out);
  }
  .hv-chart__core.is-small {
    fill: var(--star-accent);
  }
  .hv-chart__name {
    font-family: var(--hv-font-display);
    font-size: 17px;
    font-weight: 600;
    fill: var(--hv-starlight);
    letter-spacing: 0.02em;
    transition: fill var(--hv-dur-fast) var(--hv-ease-out);
  }
  .hv-chart__name.is-small {
    font-size: 14px;
    fill: var(--hv-text);
  }
  .hv-chart__tag {
    font-family: var(--hv-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    fill: var(--hv-text-faint);
  }
  .hv-chart__marker:hover .hv-chart__halo {
    opacity: 0.3;
  }
  .hv-chart__marker:hover .hv-chart__ring {
    opacity: 1;
    transform: scale(1.18);
  }
  .hv-chart__marker:hover .hv-chart__core {
    fill: var(--hv-gold-soft);
  }
  .hv-chart__marker:hover .hv-chart__name {
    fill: var(--hv-gold);
  }

  /* Caption */
  .hv-chart__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hv-space-4);
    flex-wrap: wrap;
    padding: var(--hv-space-4) var(--hv-space-2) var(--hv-space-1);
    border-top: 1px solid var(--hv-line);
    margin-top: var(--hv-space-2);
  }
  .hv-chart__title {
    font-family: var(--hv-font-mono);
    font-size: var(--hv-text-xs);
    letter-spacing: var(--hv-tracking-wide);
    color: var(--hv-gold);
  }
  .hv-chart__legend {
    display: inline-flex;
    align-items: center;
    gap: var(--hv-space-4);
    font-size: var(--hv-text-xs);
    color: var(--hv-text-faint);
  }
  .hv-chart__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hv-chart__legend-item svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: var(--hv-gold);
  }
  .hv-chart__legend-item.is-service svg {
    fill: var(--hv-text-faint);
    stroke: var(--hv-text-faint);
  }
</style>
