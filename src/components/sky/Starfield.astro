---
/*
  Starfield -- the site-wide fixed background (the portal's sky).

  Three layers: the very faint gradient of the galaxy and nebulae, then far
  stars (dense, dim, fine), then near stars (sparse, bright, a few twinkling).
  Star positions are generated at build time by a fixed-seed PRNG (same result
  every build, no client JS) and are packed more tightly along a diagonal galactic
  band -- the density distribution of a real night sky, not an even sprinkle.

  Motion budget: a few stars breathing, a very rare shooting star, and a subtle
  parallax while scrolling (lib/motion.ts writes --hv-sky-y for the parallax;
  reduced motion turns all of it off).
  aria-hidden: pure atmosphere, so it stays out of the accessibility tree.
*/

interface Star {
  x: number;
  y: number;
  r: number;
  /** Base brightness */
  o: number;
  /** Set means this star breathes (animation delay, in seconds) */
  twinkle?: number;
  /** The brightest few carry four-pointed rays */
  glint?: boolean;
}

/** mulberry32: a fixed seed, so every build generates the same sky. */
function makeRandom(seed: number): () => number {
  let s = seed >>> 0;
  return () => {
    s = (s + 0x6d2b79f5) >>> 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/**
 * Generate one layer of stars (coordinates are viewBox units, 0-1000).
 * A `bandBias` fraction of them follows the galactic band (lower left to upper
 * right); the rest are spread evenly.
 */
function makeLayer(
  seed: number,
  count: number,
  opts: {
    rMin: number;
    rMax: number;
    oMin: number;
    oMax: number;
    bandBias: number;
    twinkleEvery?: number;
    glintCount?: number;
  },
): Star[] {
  const rand = makeRandom(seed);
  const stars: Star[] = [];
  for (let i = 0; i < count; i++) {
    let x: number;
    let y: number;
    if (rand() < opts.bandBias) {
      // Galactic band: y = 880 - 0.74x, its width approximated by summing three uniforms into a near-normal spread
      x = rand() * 1000;
      const spread = (rand() + rand() + rand() - 1.5) * 210;
      y = 880 - 0.74 * x + spread;
    } else {
      x = rand() * 1000;
      y = rand() * 1000;
    }
    if (y < 0 || y > 1000) continue;

    // Brightness skews dim: most stars are background and only a few stand out (rand^3 pushes toward the lower bound)
    const bias = rand() ** 3;
    stars.push({
      x: Math.round(x * 10) / 10,
      y: Math.round(y * 10) / 10,
      r: Math.round((opts.rMin + (opts.rMax - opts.rMin) * bias) * 100) / 100,
      o: Math.round((opts.oMin + (opts.oMax - opts.oMin) * bias) * 100) / 100,
    });
  }
  // Twinkle: pick one star in every n and stagger the delays, so they never breathe in unison
  if (opts.twinkleEvery) {
    for (let i = 0; i < stars.length; i += opts.twinkleEvery) {
      stars[i]!.twinkle = Math.round(((i * 1.37) % 7) * 10) / 10;
    }
  }
  // Rays: take the brightest few
  if (opts.glintCount) {
    [...stars]
      .sort((a, b) => b.o - a.o)
      .slice(0, opts.glintCount)
      .forEach((s) => {
        s.glint = true;
      });
  }
  return stars;
}

const far = makeLayer(20260731, 170, {
  rMin: 0.5,
  rMax: 1.3,
  oMin: 0.18,
  oMax: 0.62,
  bandBias: 0.58,
});
const near = makeLayer(981231, 58, {
  rMin: 0.9,
  rMax: 2.2,
  oMin: 0.4,
  oMax: 0.95,
  bandBias: 0.34,
  twinkleEvery: 5,
  glintCount: 4,
});

/** Four-pointed rays (the cross of light outside the star body) */
const glintPath = (s: Star) => {
  const a = s.r * 3.4;
  const b = s.r * 0.6;
  return `M${s.x} ${s.y - a} Q${s.x + b} ${s.y - b} ${s.x + a} ${s.y} Q${s.x + b} ${s.y + b} ${s.x} ${s.y + a} Q${s.x - b} ${s.y + b} ${s.x - a} ${s.y} Q${s.x - b} ${s.y - b} ${s.x} ${s.y - a} Z`;
};
---

<div class="hv-sky" aria-hidden="true">
  <div class="hv-sky__wash"></div>

  <svg
    class="hv-sky__layer hv-sky__far"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="xMidYMid slice"
  >
    {far.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />)}
  </svg>

  <svg
    class="hv-sky__layer hv-sky__near"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="xMidYMid slice"
  >
    {
      near.map((s) => (
        <>
          {s.glint && (
            <path d={glintPath(s)} opacity={s.o * 0.2} class="hv-sky__glint" />
          )}
          <circle
            cx={s.x}
            cy={s.y}
            r={s.r}
            opacity={s.o}
            class:list={{ "is-twinkle": s.twinkle !== undefined }}
            style={
              s.twinkle !== undefined
                ? `--hv-o:${s.o};animation-delay:${s.twinkle}s`
                : undefined
            }
          />
        </>
      ))
    }
  </svg>

  <!-- Shooting star: very rare (one streak every 20s at most), short, thin, quiet -->
  <span class="hv-sky__meteor hv-sky__meteor--a"></span>
  <span class="hv-sky__meteor hv-sky__meteor--b"></span>
</div>

<style>
  .hv-sky {
    position: fixed;
    inset: 0;
    z-index: var(--hv-z-sky);
    overflow: hidden;
    pointer-events: none;
    background: var(--hv-night);
  }

  /* The galactic band, two very faint nebulae, and a vignette at the edges */
  .hv-sky__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        118deg,
        transparent 32%,
        var(--hv-milkyway) 47%,
        rgba(178, 200, 255, 0.075) 52%,
        var(--hv-milkyway) 57%,
        transparent 72%
      ),
      radial-gradient(
        60% 45% at 78% 12%,
        rgba(150, 130, 210, 0.09),
        transparent 70%
      ),
      radial-gradient(
        55% 40% at 12% 78%,
        rgba(90, 150, 190, 0.075),
        transparent 72%
      ),
      radial-gradient(
        120% 90% at 50% 40%,
        transparent 45%,
        rgba(4, 6, 13, 0.72) 100%
      );
  }

  /* Parallax: the two layers follow the scroll by different factors (lib/motion.ts writes --hv-sky-y) */
  .hv-sky__layer {
    position: absolute;
    inset: -10vh 0;
    width: 100%;
    height: 120vh;
    fill: var(--hv-star);
    will-change: transform;
  }
  .hv-sky__far {
    transform: translate3d(0, calc(var(--hv-sky-y, 0px) * -0.014), 0);
    fill: var(--hv-star-dim);
  }
  .hv-sky__near {
    transform: translate3d(0, calc(var(--hv-sky-y, 0px) * -0.042), 0);
  }
  .hv-sky__glint {
    fill: var(--hv-star);
  }

  /*
    Breathing twinkle: brightness only, never geometry.
    Each star's base brightness arrives through --hv-o (the CSS rule overrides
    the opacity attribute), and the animation breathes between the base value
    and base x 0.3 -- so a dim star never flashes as bright as a bright one.
  */
  .hv-sky__near circle.is-twinkle {
    opacity: var(--hv-o, 0.8);
    animation: hv-twinkle 6.5s var(--hv-ease-in-out) infinite;
  }
  @keyframes hv-twinkle {
    0%,
    100% {
      opacity: var(--hv-o, 0.8);
    }
    50% {
      opacity: calc(var(--hv-o, 0.8) * 0.3);
    }
  }

  /* Shooting star */
  .hv-sky__meteor {
    position: absolute;
    width: 132px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(223, 232, 255, 0.85)
    );
    opacity: 0;
    transform: rotate(24deg);
    animation: hv-meteor 23s linear infinite;
  }
  .hv-sky__meteor--a {
    top: 14%;
    left: -14%;
  }
  .hv-sky__meteor--b {
    top: 46%;
    left: 34%;
    width: 96px;
    animation-duration: 37s;
    animation-delay: 11s;
  }
  @keyframes hv-meteor {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(24deg);
    }
    1% {
      opacity: 0.9;
    }
    /* About 1.4s of travel; it does not exist the rest of the time */
    6% {
      opacity: 0;
      transform: translate3d(46vw, 20vw, 0) rotate(24deg);
    }
    100% {
      opacity: 0;
      transform: translate3d(46vw, 20vw, 0) rotate(24deg);
    }
  }

  /* Reduced motion: the sky holds still and no shooting star appears (the JS side turns off the parallax separately) */
  @media (prefers-reduced-motion: reduce) {
    .hv-sky__meteor {
      display: none;
    }
  }
</style>
