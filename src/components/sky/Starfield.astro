---
/*
  星空 —— 全站固定背景（門戶的「天」）。

  三層：銀河與星雲的極淡漸層 → 遠星（密、暗、細）→ 近星（疏、亮、少數閃爍）。
  星點在建置期以固定種子的 PRNG 生成（每次建置結果相同，不靠 client JS），
  並沿一條斜向銀河帶加密——真實夜空的密度分布，不是均勻灑點。

  動態預算：少數星的呼吸閃爍 ＋ 極罕見的流星 ＋ 捲動時的微視差
  （視差由 lib/motion.ts 寫入 --hv-sky-y；reduced-motion 一律關閉）。
  aria-hidden：純氛圍，不進無障礙樹。
*/

interface Star {
  x: number;
  y: number;
  r: number;
  /** 基準亮度 */
  o: number;
  /** 有值＝會呼吸閃爍（動畫延遲，秒） */
  twinkle?: number;
  /** 最亮的幾顆帶四芒光芒 */
  glint?: boolean;
}

/** mulberry32：固定種子 → 每次建置生成同一片星空。 */
function makeRandom(seed: number): () => number {
  let s = seed >>> 0;
  return () => {
    s = (s + 0x6d2b79f5) >>> 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/**
 * 生成一層星點（座標為 0–1000 的 viewBox 單位）。
 * `bandBias` 比例的星沿銀河帶（左下 → 右上）散布，其餘均勻。
 */
function makeLayer(
  seed: number,
  count: number,
  opts: {
    rMin: number;
    rMax: number;
    oMin: number;
    oMax: number;
    bandBias: number;
    twinkleEvery?: number;
    glintCount?: number;
  },
): Star[] {
  const rand = makeRandom(seed);
  const stars: Star[] = [];
  for (let i = 0; i < count; i++) {
    let x: number;
    let y: number;
    if (rand() < opts.bandBias) {
      // 銀河帶：y = 880 − 0.74x，帶寬以三次均勻和逼近常態分布
      x = rand() * 1000;
      const spread = (rand() + rand() + rand() - 1.5) * 210;
      y = 880 - 0.74 * x + spread;
    } else {
      x = rand() * 1000;
      y = rand() * 1000;
    }
    if (y < 0 || y > 1000) continue;

    // 亮度偏暗：多數星是背景，少數才顯眼（rand³ 壓向下限）
    const bias = rand() ** 3;
    stars.push({
      x: Math.round(x * 10) / 10,
      y: Math.round(y * 10) / 10,
      r: Math.round((opts.rMin + (opts.rMax - opts.rMin) * bias) * 100) / 100,
      o: Math.round((opts.oMin + (opts.oMax - opts.oMin) * bias) * 100) / 100,
    });
  }
  // 閃爍：每 n 顆挑一顆，延遲錯開，避免同步呼吸
  if (opts.twinkleEvery) {
    for (let i = 0; i < stars.length; i += opts.twinkleEvery) {
      stars[i]!.twinkle = Math.round(((i * 1.37) % 7) * 10) / 10;
    }
  }
  // 光芒：取最亮的幾顆
  if (opts.glintCount) {
    [...stars]
      .sort((a, b) => b.o - a.o)
      .slice(0, opts.glintCount)
      .forEach((s) => {
        s.glint = true;
      });
  }
  return stars;
}

const far = makeLayer(20260731, 170, {
  rMin: 0.5,
  rMax: 1.3,
  oMin: 0.18,
  oMax: 0.62,
  bandBias: 0.58,
});
const near = makeLayer(981231, 58, {
  rMin: 0.9,
  rMax: 2.2,
  oMin: 0.4,
  oMax: 0.95,
  bandBias: 0.34,
  twinkleEvery: 5,
  glintCount: 4,
});

/** 四芒光芒（星體本身之外的十字光） */
const glintPath = (s: Star) => {
  const a = s.r * 3.4;
  const b = s.r * 0.6;
  return `M${s.x} ${s.y - a} Q${s.x + b} ${s.y - b} ${s.x + a} ${s.y} Q${s.x + b} ${s.y + b} ${s.x} ${s.y + a} Q${s.x - b} ${s.y + b} ${s.x - a} ${s.y} Q${s.x - b} ${s.y - b} ${s.x} ${s.y - a} Z`;
};
---

<div class="hv-sky" aria-hidden="true">
  <div class="hv-sky__wash"></div>

  <svg
    class="hv-sky__layer hv-sky__far"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="xMidYMid slice"
  >
    {far.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />)}
  </svg>

  <svg
    class="hv-sky__layer hv-sky__near"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="xMidYMid slice"
  >
    {
      near.map((s) => (
        <>
          {s.glint && (
            <path d={glintPath(s)} opacity={s.o * 0.2} class="hv-sky__glint" />
          )}
          <circle
            cx={s.x}
            cy={s.y}
            r={s.r}
            opacity={s.o}
            class:list={{ "is-twinkle": s.twinkle !== undefined }}
            style={
              s.twinkle !== undefined
                ? `--hv-o:${s.o};animation-delay:${s.twinkle}s`
                : undefined
            }
          />
        </>
      ))
    }
  </svg>

  <!-- 流星：極罕見（20 秒以上才劃過一次），短、細、安靜 -->
  <span class="hv-sky__meteor hv-sky__meteor--a"></span>
  <span class="hv-sky__meteor hv-sky__meteor--b"></span>
</div>

<style>
  .hv-sky {
    position: fixed;
    inset: 0;
    z-index: var(--hv-z-sky);
    overflow: hidden;
    pointer-events: none;
    background: var(--hv-night);
  }

  /* 銀河帶 ＋ 兩處極淡星雲 ＋ 邊緣暗角 */
  .hv-sky__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        118deg,
        transparent 32%,
        var(--hv-milkyway) 47%,
        rgba(178, 200, 255, 0.075) 52%,
        var(--hv-milkyway) 57%,
        transparent 72%
      ),
      radial-gradient(
        60% 45% at 78% 12%,
        rgba(150, 130, 210, 0.09),
        transparent 70%
      ),
      radial-gradient(
        55% 40% at 12% 78%,
        rgba(90, 150, 190, 0.075),
        transparent 72%
      ),
      radial-gradient(
        120% 90% at 50% 40%,
        transparent 45%,
        rgba(4, 6, 13, 0.72) 100%
      );
  }

  /* 視差：兩層以不同係數跟隨捲動（--hv-sky-y 由 lib/motion.ts 寫入） */
  .hv-sky__layer {
    position: absolute;
    inset: -10vh 0;
    width: 100%;
    height: 120vh;
    fill: var(--hv-star);
    will-change: transform;
  }
  .hv-sky__far {
    transform: translate3d(0, calc(var(--hv-sky-y, 0px) * -0.014), 0);
    fill: var(--hv-star-dim);
  }
  .hv-sky__near {
    transform: translate3d(0, calc(var(--hv-sky-y, 0px) * -0.042), 0);
  }
  .hv-sky__glint {
    fill: var(--hv-star);
  }

  /*
    呼吸閃爍：只調亮度，不改幾何。
    各星的基準亮度由 --hv-o 帶入（CSS 規則會蓋過 opacity 屬性），
    動畫在「基準 ↔ 基準×0.3」之間呼吸——不會把暗星閃成亮星。
  */
  .hv-sky__near circle.is-twinkle {
    opacity: var(--hv-o, 0.8);
    animation: hv-twinkle 6.5s var(--hv-ease-in-out) infinite;
  }
  @keyframes hv-twinkle {
    0%,
    100% {
      opacity: var(--hv-o, 0.8);
    }
    50% {
      opacity: calc(var(--hv-o, 0.8) * 0.3);
    }
  }

  /* 流星 */
  .hv-sky__meteor {
    position: absolute;
    width: 132px;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(223, 232, 255, 0.85)
    );
    opacity: 0;
    transform: rotate(24deg);
    animation: hv-meteor 23s linear infinite;
  }
  .hv-sky__meteor--a {
    top: 14%;
    left: -14%;
  }
  .hv-sky__meteor--b {
    top: 46%;
    left: 34%;
    width: 96px;
    animation-duration: 37s;
    animation-delay: 11s;
  }
  @keyframes hv-meteor {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(24deg);
    }
    1% {
      opacity: 0.9;
    }
    /* 約 1.4 秒的滑行，其餘時間不存在 */
    6% {
      opacity: 0;
      transform: translate3d(46vw, 20vw, 0) rotate(24deg);
    }
    100% {
      opacity: 0;
      transform: translate3d(46vw, 20vw, 0) rotate(24deg);
    }
  }

  /* 減少動態：星空靜止，流星不出現（視差另由 JS 端關閉） */
  @media (prefers-reduced-motion: reduce) {
    .hv-sky__meteor {
      display: none;
    }
  }
</style>
