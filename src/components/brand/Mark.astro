---
/*
  Hoshivel brand mark -- redrawn as vectors from the supplied logo.

  A four-pointed star (starlight gradient, a white point at the core), two
  crossing orbit rings (cyan and gold, each carrying a planet dot), and a very
  faint halo behind the star. Pure geometry: no raster, no filters, and it still
  reads at 20px.

  variant:
    - orbit -- the official mark (two orbits, the default; redrawn from the
      supplied logo)
    - world -- the alternate (a star giving birth to a world: the star rests on
      the world's edge, echoing "begun under starsail, grown among the stars")
  With a title it renders role="img" + aria-label; without one it is
  aria-hidden, i.e. purely decorative.
*/
interface Props {
  size?: number;
  title?: string;
  class?: string;
  variant?: "orbit" | "world";
}
const {
  size = 32,
  title,
  class: className,
  variant = "orbit",
} = Astro.props;

const a11y = title
  ? { role: "img" as const, "aria-label": title }
  : { "aria-hidden": "true" as const };

/** Gradient ids must be unique site-wide (one page can hold several marks). */
const uid = `hv-mark-${Math.random().toString(36).slice(2, 9)}`;

/** The four-pointed star (centered at 32,32; slightly taller than wide, as in the original). */
const STAR =
  "M32 16.4 Q33.6 30.4 46.2 32 Q33.6 33.6 32 47.6 Q30.4 33.6 17.8 32 Q30.4 30.4 32 16.4 Z";

/** The alternate's small star (the second one, above the world). */
const SMALL_STAR =
  "M50 8.5 Q50.8 14.6 57 15.4 Q50.8 16.2 50 22.3 Q49.2 16.2 43 15.4 Q49.2 14.6 50 8.5 Z";
---

<svg
  class:list={["hv-mark", `is-${variant}`, className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
>
  <defs>
    <radialGradient id={`${uid}-halo`}>
      <stop offset="0" stop-color="#dff1fb" stop-opacity="0.5"></stop>
      <stop offset="0.55" stop-color="#bfe4f2" stop-opacity="0.12"></stop>
      <stop offset="1" stop-color="#bfe4f2" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={`${uid}-star`} x1="0.2" y1="0" x2="0.8" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.5" stop-color="#e8f6fd"></stop>
      <stop offset="1" stop-color="#a9d9ec"></stop>
    </linearGradient>
  </defs>

  <!-- Halo behind the star -->
  <circle cx="32" cy="32" r="15" fill={`url(#${uid}-halo)`}></circle>

  {
    variant === "orbit" ? (
      <>
        {/* Inner ring: a very faint circle, giving the star somewhere to be */}
        <circle class="hv-mark__disc" cx="32" cy="32" r="12.6" />
        {/* Cyan orbit (upright) */}
        <ellipse
          class="hv-mark__orbit-a"
          cx="32"
          cy="32"
          rx="13.5"
          ry="26.5"
          transform="rotate(24 32 32)"
        />
        {/* Gold orbit (flat) */}
        <ellipse
          class="hv-mark__orbit-b"
          cx="32"
          cy="32"
          rx="27"
          ry="12"
          transform="rotate(-24 32 32)"
        />
        {/* The two planet dots */}
        <circle class="hv-mark__planet-a" cx="26.4" cy="14.7" r="2.1" />
        <circle class="hv-mark__planet-b" cx="47.8" cy="16.6" r="2.1" />
      </>
    ) : (
      <>
        {/* The world: a sphere with an equator line */}
        <circle class="hv-mark__world" cx="29" cy="36" r="21" />
        <ellipse class="hv-mark__equator" cx="29" cy="36" rx="21" ry="6.5" />
        <path class="hv-mark__small-star" d={SMALL_STAR} />
      </>
    )
  }

  <!-- The four-pointed star -->
  {
    variant === "orbit" ? (
      <>
        <path class="hv-mark__star" d={STAR} fill={`url(#${uid}-star)`} />
        <circle class="hv-mark__core" cx="32" cy="32" r="1.9" />
      </>
    ) : (
      <>
        {/* The star rests on the world's edge: sitting on the rim, about to become that world */}
        <path
          class="hv-mark__star"
          d="M29 17.5 Q30.4 28.6 41.5 30 Q30.4 31.4 29 42.5 Q27.6 31.4 16.5 30 Q27.6 28.6 29 17.5 Z"
          fill={`url(#${uid}-star)`}
        />
        <circle class="hv-mark__core" cx="29" cy="30" r="1.7" />
      </>
    )
  }
</svg>

<style>
  .hv-mark {
    display: block;
    overflow: visible;
  }
  .hv-mark__disc {
    fill: none;
    stroke: var(--hv-orbit);
    stroke-opacity: 0.22;
    stroke-width: 1;
  }
  .hv-mark__orbit-a {
    fill: none;
    stroke: var(--hv-orbit);
    stroke-width: 1.6;
  }
  .hv-mark__orbit-b {
    fill: none;
    stroke: var(--hv-gold-deep);
    stroke-width: 1.6;
  }
  .hv-mark__planet-a {
    fill: var(--hv-orbit);
  }
  .hv-mark__planet-b {
    fill: var(--hv-gold-deep);
  }
  .hv-mark__core {
    fill: #ffffff;
  }

  /* Alternate: a star giving birth to a world */
  .hv-mark__world {
    fill: none;
    stroke: var(--hv-gold-deep);
    stroke-width: 1.6;
  }
  .hv-mark__equator {
    fill: none;
    stroke: var(--hv-orbit);
    stroke-width: 1.4;
    stroke-opacity: 0.85;
  }
  .hv-mark__small-star {
    fill: var(--hv-gold);
  }
</style>
