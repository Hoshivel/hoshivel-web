---
/*
  Hoshivel 品牌標記（第二版）—— 朱印。
  方正的朱紅印面，鏤白四芒星：星是名（hoshi），印是署名的手。
  純幾何、無發光無漸層——印章蓋在紙上，不需要光。
  title 有值 → role="img" + aria-label；無值 → aria-hidden（純裝飾）。
*/
interface Props {
  size?: number;
  title?: string;
  class?: string;
  /** 墨面（footer）上使用時反白邊。 */
  onInk?: boolean;
}
const { size = 32, title, class: className, onInk = false } = Astro.props;

const a11y = title
  ? { role: "img" as const, "aria-label": title }
  : { "aria-hidden": "true" as const };
---

<svg
  class:list={["hv-mark", { "on-ink": onInk }, className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
>
  <!-- 印面 -->
  <rect x="1.5" y="1.5" width="29" height="29" rx="5" fill="#b23a26"></rect>
  <!-- 印框（內縮細線，印章的邊） -->
  <rect
    x="4.5"
    y="4.5"
    width="23"
    height="23"
    rx="3"
    fill="none"
    stroke="#fdfbf5"
    stroke-opacity="0.55"
    stroke-width="1"></rect>
  <!-- 鏤白四芒星 -->
  <path
    d="M16 7.5
       C 16.9 11.8 20.2 15.1 24.5 16
       C 20.2 16.9 16.9 20.2 16 24.5
       C 15.1 20.2 11.8 16.9 7.5 16
       C 11.8 15.1 15.1 11.8 16 7.5 Z"
    fill="#fdfbf5"></path>
</svg>

<style>
  .hv-mark {
    display: block;
  }
  .hv-mark.on-ink {
    /* 墨面上印章微亮一階，維持存在感 */
    filter: brightness(1.08);
  }
</style>
