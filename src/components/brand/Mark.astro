---
/*
  Hoshivel 品牌標記（第三版）—— 星盤。
  一枚四芒星，外圍一圈星盤環與四道斜刻度：夜裡定位用的儀器。
  純幾何、單一金色，縮到 16px 仍成立（favicon 同版）。
  title 有值 → role="img" + aria-label；無值 → aria-hidden（純裝飾）。
*/
interface Props {
  size?: number;
  title?: string;
  class?: string;
}
const { size = 32, title, class: className } = Astro.props;

const a11y = title
  ? { role: "img" as const, "aria-label": title }
  : { "aria-hidden": "true" as const };

/** 星盤環上的四道斜刻度（45°，避開星芒的四個正向尖端）。 */
const TICKS = [
  [24.5, 24.5, 26.6, 26.6],
  [7.5, 24.5, 5.4, 26.6],
  [24.5, 7.5, 26.6, 5.4],
  [7.5, 7.5, 5.4, 5.4],
];
---

<svg
  class:list={["hv-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
>
  <!-- 星盤環 -->
  <circle class="hv-mark__ring" cx="16" cy="16" r="13.5"></circle>
  <!-- 斜刻度 -->
  {
    TICKS.map(([x1, y1, x2, y2]) => (
      <line class="hv-mark__tick" x1={x1} y1={y1} x2={x2} y2={y2} />
    ))
  }
  <!-- 四芒星 -->
  <path
    class="hv-mark__star"
    d="M16 5.6 Q17.3 14.7 26.4 16 Q17.3 17.3 16 26.4 Q14.7 17.3 5.6 16 Q14.7 14.7 16 5.6 Z"
  ></path>
</svg>

<style>
  .hv-mark {
    display: block;
    overflow: visible;
  }
  .hv-mark__ring {
    stroke: var(--hv-gold);
    stroke-opacity: 0.45;
    stroke-width: 1;
  }
  .hv-mark__tick {
    stroke: var(--hv-gold);
    stroke-opacity: 0.75;
    stroke-width: 1;
    stroke-linecap: round;
  }
  .hv-mark__star {
    fill: var(--hv-gold);
  }
</style>
