---
/*
  Hoshivel 字標鎖定組（第三版）—— 星盤 + 明體名。
  variant：
    - mark    —— 只有星盤（Mark 帶 aria-label）
    - compact —— 星盤 + 名稱（header 用）
    - full    —— 星盤 + 名稱 + 標語（footer / OG 用）
  全站同一片夜空，不再需要反白變體。
*/
import Mark from "./Mark.astro";
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  variant?: "mark" | "compact" | "full";
  size?: number;
  class?: string;
}
const { locale, variant = "compact", size, class: className } = Astro.props;

const t = useTranslations(locale);
const name = t("site.name");
const tagline = t("site.tagline");
const markSize = size ?? (variant === "full" ? 38 : 26);
---

<span class:list={["hv-wordmark", `is-${variant}`, className]}>
  <Mark size={markSize} title={variant === "mark" ? name : undefined} />
  {
    variant !== "mark" && (
      <span class="hv-wordmark__text">
        <span class="hv-wordmark__name">{name}</span>
        {variant === "full" && (
          <span class="hv-wordmark__tagline">{tagline}</span>
        )}
      </span>
    )
  }
</span>

<style>
  .hv-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hv-wordmark.is-full {
    gap: 0.8rem;
  }
  .hv-wordmark__text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }
  .hv-wordmark__name {
    font-family: var(--hv-font-display);
    font-weight: 600;
    letter-spacing: 0.06em;
    font-size: 1.18rem;
    color: var(--hv-starlight);
  }
  .hv-wordmark.is-full .hv-wordmark__name {
    font-size: 1.45rem;
  }
  .hv-wordmark__tagline {
    color: var(--hv-text-faint);
    letter-spacing: 0.2em;
    font-size: 0.62rem;
    margin-top: 0.4rem;
  }
</style>
