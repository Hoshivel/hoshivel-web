---
/*
  Hoshivel 字標鎖定組（Mark + 名稱）。
  variant：
    - mark    —— 只有星標（Mark 帶 aria-label）
    - compact —— 星標 + 名稱（header 用）
    - full    —— 星標 + 名稱 + 標語（footer / OG 用）
*/
import Mark from "./Mark.astro";
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  variant?: "mark" | "compact" | "full";
  size?: number;
  glow?: boolean;
  class?: string;
}
const {
  locale,
  variant = "compact",
  size,
  glow = false,
  class: className,
} = Astro.props;

const t = useTranslations(locale);
const name = t("site.name");
const tagline = t("site.tagline");
const markSize = size ?? (variant === "full" ? 40 : 26);
---

<span class:list={["hv-wordmark", `is-${variant}`, className]}>
  <Mark size={markSize} glow={glow} title={variant === "mark" ? name : undefined} />
  {
    variant !== "mark" && (
      <span class="hv-wordmark__text">
        <span class="hv-wordmark__name hv-gradient-text">{name}</span>
        {variant === "full" && <span class="hv-wordmark__tagline">{tagline}</span>}
      </span>
    )
  }
</span>

<style>
  .hv-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hv-wordmark.is-full {
    gap: 0.7rem;
  }
  .hv-wordmark__text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }
  .hv-wordmark__name {
    font-family: var(--hv-font-sans);
    font-weight: 800;
    letter-spacing: 0.08em;
    font-size: 1.12rem;
  }
  .hv-wordmark.is-full .hv-wordmark__name {
    font-size: 1.45rem;
  }
  .hv-wordmark__tagline {
    color: var(--hv-text-muted);
    letter-spacing: 0.18em;
    font-size: 0.62rem;
    margin-top: 0.3rem;
  }
</style>
