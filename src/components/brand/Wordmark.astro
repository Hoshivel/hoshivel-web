---
/*
  Hoshivel wordmark lockup -- the mark plus the serif name, with the last two
  letters in gold as in the original logo.
  variant:
    - mark    -- the mark alone (Mark carries the aria-label)
    - compact -- mark + name (used by the header)
    - full    -- mark + name + tagline (used by the footer and OG image)
*/
import Mark from "./Mark.astro";
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  variant?: "mark" | "compact" | "full";
  size?: number;
  class?: string;
}
const { locale, variant = "compact", size, class: className } = Astro.props;

const t = useTranslations(locale);
const name = t("site.name");
const tagline = t("site.tagline");
const markSize = size ?? (variant === "full" ? 44 : 30);

// The last two letters go gold: the wordmark's own identifying detail (the brand name is still one whole word, just colored)
const head = name.slice(0, -2);
const tail = name.slice(-2);
---

<span class:list={["hv-wordmark", `is-${variant}`, className]}>
  <Mark size={markSize} title={variant === "mark" ? name : undefined} />
  {
    variant !== "mark" && (
      <span class="hv-wordmark__text">
        {/* No wrapping and no whitespace: the wordmark is a single word */}
        <span class="hv-wordmark__name">{head}<span class="hv-wordmark__tail">{tail}</span></span>
        {variant === "full" && (
          <span class="hv-wordmark__tagline">{tagline}</span>
        )}
      </span>
    )
  }
</span>

<style>
  .hv-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .hv-wordmark.is-full {
    gap: 0.85rem;
  }
  .hv-wordmark__text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }
  .hv-wordmark__name {
    font-family: var(--hv-font-display);
    font-weight: 600;
    letter-spacing: 0.03em;
    font-size: 1.3rem;
    color: var(--hv-starlight);
  }
  .hv-wordmark.is-full .hv-wordmark__name {
    font-size: 1.6rem;
  }
  /* Last two letters: a gold gradient (environments without background-clip fall back to solid gold) */
  .hv-wordmark__tail {
    color: var(--hv-gold);
    background: linear-gradient(
      100deg,
      var(--hv-gold-soft),
      var(--hv-gold) 45%,
      var(--hv-gold-deep)
    );
    -webkit-background-clip: text;
    background-clip: text;
  }
  @supports (-webkit-background-clip: text) or (background-clip: text) {
    .hv-wordmark__tail {
      color: transparent;
    }
  }
  .hv-wordmark__tagline {
    color: var(--hv-text-faint);
    letter-spacing: 0.16em;
    font-size: 0.66rem;
    margin-top: 0.5rem;
  }
</style>
