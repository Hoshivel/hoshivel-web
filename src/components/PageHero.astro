---
/*
  Subpage hero -- a Bayer-mark eyebrow, a serif headline and a lead paragraph,
  closed by the star-map rule.
  This is the shared information rhythm of every subpage.
*/
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Bayer mark (α / β / γ...; the page computes it with bayer() and passes it in). */
  mark?: string;
}
const { eyebrow, title, lead, mark } = Astro.props;
---

<div class="hv-page-hero">
  <div class="hv-container">
    <p class="hv-eyebrow" data-reveal>
      {mark && <span class="hv-eyebrow__mark">{mark}</span>}
      {eyebrow}
    </p>
    <h1 class="hv-page-hero__title hv-display" data-reveal>{title}</h1>
    {lead && <p class="hv-lead hv-page-hero__lead" data-reveal>{lead}</p>}
  </div>
  <div class="hv-container">
    <hr class="hv-rule hv-page-hero__rule" />
  </div>
</div>

<style>
  .hv-page-hero {
    padding-top: clamp(3.5rem, 8vw, 6rem);
  }
  .hv-page-hero__title {
    margin-top: var(--hv-space-4);
    max-width: 24ch;
    font-size: var(--hv-text-2xl);
  }
  .hv-page-hero__lead {
    margin-top: var(--hv-space-4);
    max-width: 56ch;
  }
  .hv-page-hero__rule {
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
  }
</style>
