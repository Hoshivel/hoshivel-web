---
/*
  News card (list item) -- one entry of the observation log: date and tag, a
  serif title, the summary, and a read link.
  The whole card is clickable; <time> carries a datetime and the date is
  rendered the way the locale writes it.
*/
import {
  useTranslations,
  localizedPath,
  formatDate,
  type Locale,
} from "@/i18n/utils";
import type { NewsEntry } from "@/lib/news";

interface Props {
  locale: Locale;
  post: NewsEntry;
}
const { locale, post } = Astro.props;
const t = useTranslations(locale);
const href = localizedPath(locale, `/news/${post.data.slug}`);
const iso = post.data.date.toISOString().slice(0, 10);
---

<article class="hv-plate hv-news-card" data-reveal>
  <a class="hv-news-card__link" href={href}>
    <p class="hv-news-card__meta">
      <time datetime={iso}>{formatDate(locale, post.data.date)}</time>
      {post.data.tag && <span class="hv-news-card__tag">{post.data.tag}</span>}
    </p>
    <h3 class="hv-news-card__title hv-display">{post.data.title}</h3>
    <p class="hv-news-card__summary">{post.data.summary}</p>
    <span class="hv-more" aria-hidden="true">{t("news.readMore")}</span>
  </a>
</article>

<style>
  .hv-news-card__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--hv-space-3);
    padding: var(--hv-space-6) var(--hv-space-8);
    height: 100%;
  }
  /* The row is as tall with a tag as without one, so the titles of cards side
     by side start on the same line. */
  .hv-news-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 1.6rem;
    font-size: var(--hv-text-xs);
    color: var(--hv-text-faint);
    letter-spacing: 0.05em;
  }
  .hv-news-card__meta time {
    white-space: nowrap;
    font-family: var(--hv-font-mono);
  }
  .hv-news-card__tag {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--hv-line-strong);
    border-radius: var(--hv-radius-sm);
    color: var(--hv-text-soft);
  }
  /*
    A title breaks between phrases, not inside a word: CJK may otherwise break
    between any two characters, which left a lone 「線」 on the second line and
    split 「狀態」 across two. Lines break at spaces and punctuation instead (and
    anywhere, as a last resort, rather than overflow); Japanese uses the
    browser's phrase segmentation where it has one.
  */
  .hv-news-card__title {
    font-size: var(--hv-text-lg);
    text-wrap: balance;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .hv-news-card__title:lang(ja) {
    word-break: auto-phrase;
  }
  .hv-news-card__summary {
    color: var(--hv-text-soft);
    font-size: var(--hv-text-sm);
  }
  .hv-news-card__link .hv-more {
    margin-top: auto;
  }
</style>
