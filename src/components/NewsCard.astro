---
/*
  新聞卡（列表項）—— 日期 / 標籤 + 明體標題 + 摘要 + 閱讀連結。
  整卡可點；<time> 帶 datetime，日期依語言慣例呈現。
*/
import {
  useTranslations,
  localizedPath,
  formatDate,
  type Locale,
} from "@/i18n/utils";
import type { NewsEntry } from "@/lib/news";

interface Props {
  locale: Locale;
  post: NewsEntry;
}
const { locale, post } = Astro.props;
const t = useTranslations(locale);
const href = localizedPath(locale, `/news/${post.data.slug}`);
const iso = post.data.date.toISOString().slice(0, 10);
---

<article class="hv-card hv-news-card" data-reveal>
  <a class="hv-news-card__link" href={href}>
    <p class="hv-news-card__meta">
      <time datetime={iso}>{formatDate(locale, post.data.date)}</time>
      {post.data.tag && <span class="hv-news-card__tag">{post.data.tag}</span>}
    </p>
    <h3 class="hv-news-card__title hv-display">{post.data.title}</h3>
    <p class="hv-news-card__summary">{post.data.summary}</p>
    <span class="hv-more" aria-hidden="true">{t("news.readMore")}</span>
  </a>
</article>

<style>
  .hv-news-card__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--hv-space-3);
    padding: var(--hv-space-6) var(--hv-space-8);
    height: 100%;
  }
  .hv-news-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--hv-text-xs);
    color: var(--hv-ink-faint);
    letter-spacing: 0.05em;
  }
  .hv-news-card__meta time {
    white-space: nowrap;
  }
  .hv-news-card__tag {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--hv-hairline-strong);
    border-radius: var(--hv-radius-sm);
    color: var(--hv-ink-soft);
  }
  .hv-news-card__title {
    font-size: var(--hv-text-lg);
  }
  .hv-news-card__summary {
    color: var(--hv-ink-soft);
    font-size: var(--hv-text-sm);
  }
  .hv-news-card__link .hv-more {
    margin-top: auto;
  }
</style>
