---
/*
  作品卡（首頁用）—— 圖版卡：星表編號 + 識別色星記 + 名稱 / 類型 / 摘要 / 入口。
  識別色只出現在星記與類型字，不染整卡（夜面要乾淨）。
*/
import { useTranslations, localizedPath, type Locale } from "@/i18n/utils";
import type { Product } from "@/lib/products";

interface Props {
  locale: Locale;
  product: Product;
}
const { locale, product } = Astro.props;
const t = useTranslations(locale);
const detailHref = localizedPath(locale, `/works#${product.id}`);
const name = t(product.nameKey);
const latin = t(product.latinKey);
/** 名稱本身已是拉丁字時（en 語系），副標重複就不顯示。 */
const showLatin = latin.toLowerCase() !== name.toLowerCase();
---

<article
  class="hv-plate hv-product-card"
  style={`--card-accent: var(${product.accentVar})`}
  data-reveal
>
  <a class="hv-product-card__cover" href={detailHref}>
    <div class="hv-product-card__top">
      <span class="hv-product-card__id">
        <svg
          class="hv-product-card__star"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M12 2 Q13 11 22 12 Q13 13 12 22 Q11 13 2 12 Q11 11 12 2 Z"
          ></path>
        </svg>
        <span class="hv-catalog">{product.catalog}</span>
      </span>
      <span class="hv-badge" class:list={{ "hv-badge--live": product.live }}>
        {t(product.statusKey)}
      </span>
    </div>
    <h3 class="hv-product-card__name hv-display">
      {name}
      {showLatin && <span class="hv-product-card__latin">{latin}</span>}
    </h3>
    <p class="hv-product-card__kind">{t(product.kindKey)}</p>
    <p class="hv-product-card__desc">{t(product.descKey)}</p>
  </a>
  <div class="hv-product-card__foot">
    <a class="hv-more" href={detailHref}>{t("cta.detail")}</a>
    {
      product.url && (
        <a
          class="hv-btn hv-btn--ghost hv-product-card__visit"
          href={product.url}
          target="_blank"
          rel="noopener"
        >
          {t("cta.visit")}
          <span aria-hidden="true">↗</span>
          <span class="hv-visually-hidden">{t("a11y.external")}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .hv-product-card {
    display: flex;
    flex-direction: column;
  }
  .hv-product-card__cover {
    display: block;
    padding: var(--hv-space-8);
    flex: 1;
  }
  .hv-product-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hv-space-4);
  }
  /* 星表列首：識別色星記 ＋ 編號 */
  .hv-product-card__id {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .hv-product-card__star {
    width: 15px;
    height: 15px;
    fill: var(--card-accent);
    transition: filter var(--hv-dur) var(--hv-ease-out);
  }
  .hv-product-card:hover .hv-product-card__star {
    filter: drop-shadow(0 0 6px var(--card-accent));
  }
  .hv-product-card__name {
    margin-top: var(--hv-space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--hv-text-xl);
  }
  .hv-product-card__latin {
    font-family: var(--hv-font-mono);
    font-size: var(--hv-text-xs);
    letter-spacing: var(--hv-tracking-wide);
    color: var(--hv-text-faint);
  }
  .hv-product-card__kind {
    margin-top: var(--hv-space-2);
    font-size: var(--hv-text-sm);
    font-weight: 600;
    color: var(--card-accent);
  }
  .hv-product-card__desc {
    margin-top: var(--hv-space-4);
    color: var(--hv-text-soft);
    font-size: var(--hv-text-sm);
    max-width: 52ch;
  }
  .hv-product-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hv-space-4);
    padding: var(--hv-space-4) var(--hv-space-8) var(--hv-space-6);
    border-top: 1px solid var(--hv-line);
  }
  .hv-product-card__visit {
    padding: 0.55rem 1.1rem;
  }
</style>
