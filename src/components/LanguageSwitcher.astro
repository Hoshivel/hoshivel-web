---
/*
  Language switcher -- plain SSR links, no JS.
  Each locale links to its own URL for the same logical page; the current
  language carries aria-current.
  Short labels (繁/简/日/EN) with the full name in title/aria-label.
  The number of cells follows LOCALES: a narrow screen squeezes the whole strip,
  so min-width is held at 2rem.
*/
import {
  useTranslations,
  localizedPath,
  LOCALES,
  LOCALE_LABEL,
  LOCALE_SHORT,
  HTML_LANG,
  type Locale,
} from "@/i18n/utils";
import { globalLanguageForLocale } from "@/lib/preferences";

interface Props {
  locale: Locale;
  /** Logical path (no locale prefix); defaults to the home page. */
  path?: string;
  class?: string;
}
const { locale, path = "/", class: className } = Astro.props;
const t = useTranslations(locale);
---

<nav class:list={["hv-lang", className]} aria-label={t("a11y.langMenu")}>
  {
    LOCALES.map((l) => {
      const active = l === locale;
      return (
        <a
          href={localizedPath(l, path)}
          class:list={["hv-lang__item", { "is-active": active }]}
          hreflang={HTML_LANG[l]}
          title={LOCALE_LABEL[l]}
          aria-current={active ? "true" : undefined}
          data-hoshi-language={globalLanguageForLocale(l)}
        >
          {LOCALE_SHORT[l]}
        </a>
      );
    })
  }
</nav>

<style>
  .hv-lang {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--hv-line-strong);
    border-radius: var(--hv-radius);
    overflow: hidden;
  }
  .hv-lang__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    padding: 0.28rem 0.55rem;
    font-size: var(--hv-text-xs);
    color: var(--hv-text-soft);
    transition:
      color var(--hv-dur-fast) var(--hv-ease-out),
      background-color var(--hv-dur-fast) var(--hv-ease-out);
  }
  .hv-lang__item + .hv-lang__item {
    border-left: 1px solid var(--hv-line);
  }
  .hv-lang__item:hover {
    color: var(--hv-starlight);
    background: rgba(176, 198, 240, 0.06);
  }
  .hv-lang__item.is-active {
    color: #14171f;
    background: var(--hv-gold);
  }
</style>
