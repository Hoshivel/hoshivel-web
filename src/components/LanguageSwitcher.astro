---
/*
  語言切換器 —— 純 SSR 連結（無 JS）。
  三語各連到「同一邏輯頁」的對應 locale URL；目前語言標 aria-current。
  精簡標籤（繁/简/EN）＋完整名放 title/aria-label。
*/
import {
  useTranslations,
  localizedPath,
  LOCALES,
  LOCALE_LABEL,
  LOCALE_SHORT,
  HTML_LANG,
  type Locale,
} from "@/i18n/utils";

interface Props {
  locale: Locale;
  /** 邏輯路徑（不含 locale 前綴），預設首頁。 */
  path?: string;
  class?: string;
  /** 墨面（footer）上的反白配色。 */
  onInk?: boolean;
}
const { locale, path = "/", class: className, onInk = false } = Astro.props;
const t = useTranslations(locale);
---

<nav class:list={["hv-lang", { "on-ink": onInk }, className]} aria-label={t("a11y.langMenu")}>
  {
    LOCALES.map((l) => {
      const active = l === locale;
      return (
        <a
          href={localizedPath(l, path)}
          class:list={["hv-lang__item", { "is-active": active }]}
          hreflang={HTML_LANG[l]}
          title={LOCALE_LABEL[l]}
          aria-current={active ? "true" : undefined}
        >
          {LOCALE_SHORT[l]}
        </a>
      );
    })
  }
</nav>

<style>
  .hv-lang {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--hv-hairline-strong);
    border-radius: var(--hv-radius);
    overflow: hidden;
  }
  .hv-lang__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    padding: 0.28rem 0.55rem;
    font-size: var(--hv-text-xs);
    color: var(--hv-ink-soft);
    transition:
      color var(--hv-dur-fast) var(--hv-ease-out),
      background-color var(--hv-dur-fast) var(--hv-ease-out);
  }
  .hv-lang__item + .hv-lang__item {
    border-left: 1px solid var(--hv-hairline);
  }
  .hv-lang__item:hover {
    color: var(--hv-ink-strong);
  }
  .hv-lang__item.is-active {
    color: var(--hv-paper-on-ink);
    background: var(--hv-ink-bg);
  }

  /* 墨面（footer）反白 */
  .hv-lang.on-ink {
    border-color: var(--hv-hairline-on-ink);
  }
  .hv-lang.on-ink .hv-lang__item {
    color: var(--hv-muted-on-ink);
  }
  .hv-lang.on-ink .hv-lang__item + .hv-lang__item {
    border-left-color: var(--hv-hairline-on-ink);
  }
  .hv-lang.on-ink .hv-lang__item:hover {
    color: var(--hv-paper-on-ink);
  }
  .hv-lang.on-ink .hv-lang__item.is-active {
    color: var(--hv-ink-strong);
    background: var(--hv-paper-on-ink);
  }
</style>
