---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Starfield from "@/components/sky/Starfield.astro";
import PreferenceBootstrap from "@/components/PreferenceBootstrap.astro";
import CookiePreferences from "@/components/CookiePreferences.astro";
import { newsFeedPath, newsFeedTitle } from "@/lib/rss";
import { GITHUB_URL, SOCIAL_LINKS, SR_URL } from "@/lib/site";
import {
  useTranslations,
  localizedPath,
  stripLocalePrefix,
  HTML_LANG,
  OG_LOCALE,
  HAN_FONT,
  LOCALES,
  DEFAULT_LOCALE,
  type Locale,
} from "@/i18n/utils";

interface Props {
  locale?: Locale;
  /** 頁名（自動接上「— Hoshivel」）；不給 = 首頁形式（Hoshivel — 標語）。 */
  title?: string;
  description?: string;
  /** 語言切換器要使用的邏輯路徑；404 可指定首頁，避免建立不存在的多語 404。 */
  navigationPath?: string;
}

const { locale = DEFAULT_LOCALE, title, description, navigationPath } = Astro.props;
const t = useTranslations(locale);

const siteName = t("site.name");
const metaTagline = t("site.metaTagline");
const pageTitle = title
  ? `${title} — ${siteName}`
  : `${siteName} — ${metaTagline}`;
const pageDescription = description ?? t("site.summary");

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// hreflang：把同一頁的各語言版本互相標示（含 x-default → 預設語言）。
const logicalPath = stripLocalePrefix(Astro.url.pathname);
const chromePath = navigationPath ?? logicalPath;
const alternates = LOCALES.map((l) => ({
  hreflang: HTML_LANG[l],
  href: Astro.site
    ? new URL(localizedPath(l, logicalPath), Astro.site).href
    : localizedPath(l, logicalPath),
}));
const xDefault = Astro.site
  ? new URL(localizedPath(DEFAULT_LOCALE, logicalPath), Astro.site).href
  : localizedPath(DEFAULT_LOCALE, logicalPath);

// 結構化資料（首頁）。它回答「這個網域是誰」，並把 sr-web 那邊指過來的
// `https://hoshivel.com/#organization` 變成一個真的存在的節點——兩份標記
// 用同一個 @id 才連得起來，改動這裡的 @id 就要同時改 sr-web 的 Layout。
const isHomePage = logicalPath === "/";
const siteRoot = Astro.site?.href ?? "https://hoshivel.com/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hoshivel.com/#organization",
      name: "Hoshivel",
      alternateName: ["星帆"],
      url: "https://hoshivel.com/",
      sameAs: [GITHUB_URL, ...SOCIAL_LINKS.map((link) => link.url)],
    },
    {
      "@type": "WebSite",
      "@id": `${siteRoot}#website`,
      url: siteRoot,
      name: "Hoshivel",
      alternateName: ["星帆"],
      inLanguage: LOCALES.map((l) => HTML_LANG[l]),
      publisher: { "@id": "https://hoshivel.com/#organization" },
    },
    {
      // 作品實體的正本在 sr-web（同一個 @id）；這裡只是從門戶這一側指認它，
      // 讓「碎界」「Shattered Realms」「Hoshivel」在兩個網域上是同一件事。
      "@type": "VideoGame",
      "@id": "https://sr.hoshivel.com/#game",
      url: SR_URL,
      name: "Shattered Realms",
      alternateName: ["碎界", "砕界"],
      author: { "@id": "https://hoshivel.com/#organization" },
      publisher: { "@id": "https://hoshivel.com/#organization" },
    },
  ],
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 盡早標記 JS 可用：reveal 內容只在有 JS 時預先隱藏，避免無 JS 環境被永久藏住 -->
    <script is:inline>
      document.documentElement.classList.add("hv-js");
    </script>
    <PreferenceBootstrap
      locale={locale}
      path={logicalPath}
      enabled={navigationPath === undefined}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 自訂明體：標題與字標的 LCP 依賴它，先行預載（依語言各載一支漢字面） -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/playfair-display-600.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={HAN_FONT[locale]}
      crossorigin
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <!-- 新聞 RSS：只掛本語系那一份。四份全掛上去，閱讀器會叫使用者從四個
         看不懂的裡面挑一個——語言在訂閱時就該決定好（見 lib/rss.ts） -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={newsFeedTitle(locale)}
      href={newsFeedPath(locale)}
    />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#080b15" />

    <!-- i18n 交替連結 -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${metaTagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og.png" />

    {isHomePage && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <meta name="twitter:image:alt" content={`${siteName} — ${metaTagline}`} />
  </head>
  <body>
    <!-- 天：固定於所有內容之下（純裝飾） -->
    <Starfield />

    <Header locale={locale} path={chromePath} />
    <slot />
    <Footer locale={locale} path={chromePath} />
    <CookiePreferences locale={locale} />

    <script>
      // 捲動動效：reveal-on-scroll ＋ 星空微視差（皆 reduced-motion 友善）。
      import { initScrollReveal, initSkyParallax } from "@/lib/motion";
      initScrollReveal();
      initSkyParallax();
    </script>
  </body>
</html>
