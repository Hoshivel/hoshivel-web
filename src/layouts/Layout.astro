---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Starfield from "@/components/sky/Starfield.astro";
import PreferenceBootstrap from "@/components/PreferenceBootstrap.astro";
import CookiePreferences from "@/components/CookiePreferences.astro";
import { newsFeedPath, newsFeedTitle } from "@/lib/rss";
import { GITHUB_URL, SOCIAL_LINKS, SR_URL } from "@/lib/site";
import {
  useTranslations,
  localizedPath,
  stripLocalePrefix,
  HTML_LANG,
  OG_LOCALE,
  HAN_FONT,
  LOCALES,
  DEFAULT_LOCALE,
  type Locale,
} from "@/i18n/utils";

interface Props {
  locale?: Locale;
  /** Page name ("— Hoshivel" is appended automatically); omit it for the home form (Hoshivel — tagline). */
  title?: string;
  description?: string;
  /** Logical path for the language switcher; 404 can point at the home page, so no per-language 404 pages need to exist. */
  navigationPath?: string;
}

const { locale = DEFAULT_LOCALE, title, description, navigationPath } = Astro.props;
const t = useTranslations(locale);

const siteName = t("site.name");
const metaTagline = t("site.metaTagline");
const pageTitle = title
  ? `${title} — ${siteName}`
  : `${siteName} — ${metaTagline}`;
const pageDescription = description ?? t("site.summary");

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// hreflang: cross-link every language version of the same page (x-default points at the default locale).
const logicalPath = stripLocalePrefix(Astro.url.pathname);
const chromePath = navigationPath ?? logicalPath;
const alternates = LOCALES.map((l) => ({
  hreflang: HTML_LANG[l],
  href: Astro.site
    ? new URL(localizedPath(l, logicalPath), Astro.site).href
    : localizedPath(l, logicalPath),
}));
const xDefault = Astro.site
  ? new URL(localizedPath(DEFAULT_LOCALE, logicalPath), Astro.site).href
  : localizedPath(DEFAULT_LOCALE, logicalPath);

// Structured data (home page). It answers "who is this domain", and turns the
// `https://hoshivel.com/#organization` that sr-web points at into a node that
// actually exists -- the two markup blocks only link up while they share one
// @id, so changing the @id here means changing sr-web's Layout in the same batch.
const isHomePage = logicalPath === "/";
const siteRoot = Astro.site?.href ?? "https://hoshivel.com/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hoshivel.com/#organization",
      name: "Hoshivel",
      alternateName: ["星帆"],
      url: "https://hoshivel.com/",
      sameAs: [GITHUB_URL, ...SOCIAL_LINKS.map((link) => link.url)],
    },
    {
      "@type": "WebSite",
      "@id": `${siteRoot}#website`,
      url: siteRoot,
      name: "Hoshivel",
      alternateName: ["星帆"],
      inLanguage: LOCALES.map((l) => HTML_LANG[l]),
      publisher: { "@id": "https://hoshivel.com/#organization" },
    },
    {
      // The canonical copy of the work entity lives in sr-web (same @id); this
      // only identifies it from the portal's side, so that 碎界, Shattered
      // Realms and Hoshivel are one thing across both domains.
      "@type": "VideoGame",
      "@id": "https://sr.hoshivel.com/#game",
      url: SR_URL,
      name: "Shattered Realms",
      alternateName: ["碎界", "砕界"],
      author: { "@id": "https://hoshivel.com/#organization" },
      publisher: { "@id": "https://hoshivel.com/#organization" },
    },
  ],
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mark JS availability as early as possible: reveal content is only pre-hidden when JS is present, so a JS-less environment never hides it forever -->
    <script is:inline>
      document.documentElement.classList.add("hv-js");
    </script>
    <PreferenceBootstrap
      locale={locale}
      path={logicalPath}
      enabled={navigationPath === undefined}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Custom serif: headline and wordmark LCP depend on it, so preload it (one Han face per language) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/playfair-display-600.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={HAN_FONT[locale]}
      crossorigin
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <!-- News RSS: advertise only this locale's feed. Listing all four makes the
         reader ask the user to pick from four they cannot read -- the language
         belongs to the subscribe step (see lib/rss.ts) -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={newsFeedTitle(locale)}
      href={newsFeedPath(locale)}
    />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#080b15" />

    <!-- i18n alternate links -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${metaTagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og.png" />

    {isHomePage && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <meta name="twitter:image:alt" content={`${siteName} — ${metaTagline}`} />
  </head>
  <body>
    <!-- The sky: fixed beneath all content (purely decorative) -->
    <Starfield />

    <Header locale={locale} path={chromePath} />
    <slot />
    <Footer locale={locale} path={chromePath} />
    <CookiePreferences locale={locale} />

    <script>
      // Scroll motion: reveal-on-scroll plus the starfield parallax (both reduced-motion aware).
      import { initScrollReveal, initSkyParallax } from "@/lib/motion";
      initScrollReveal();
      initSkyParallax();
    </script>
  </body>
</html>
